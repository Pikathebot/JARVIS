# Engine
LLAMA_SERVER_EXE=tools/llama-cpp/llama-server.exe
LLAMA_BASE_URL=http://localhost:8001/v1
LLAMA_MAIN_MODEL_PATH=models/qwen3.5-9b/Qwen3.5-9B-UD-Q3_K_XL.gguf
LLAMA_FAST_MODEL_PATH=models/qwen3.5-4b/Qwen3.5-4B-UD-Q4_K_XL.gguf
# Flash attention + quantised KV cache so a 9B and a 16k context share 8GB of VRAM (q8_0 KV is
# within perplexity noise of f16 on Qwen3.5). --spec-type ngram-simple is draft-free speculative
# decoding: zero VRAM, output identical, several times faster on copy-heavy output.
LLAMA_EXTRA_ARGS=["-fa","on","--cache-type-k","q8_0","--cache-type-v","q8_0","--spec-type","ngram-simple","--temp","0.6","--top-p","0.95","--top-k","20","--min-p","0.0"]
# Forwarded into llama-server's environment (it does not accept this on the command line).
LLAMA_CHAT_TEMPLATE_KWARGS={"enable_thinking":true}
# Per-slot override for the fast (4B) model, which rambles more in its thinking block.
LLAMA_CHAT_TEMPLATE_KWARGS_FAST={"enable_thinking":false}
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8001
LLAMA_STARTUP_TIMEOUT=90.0
# Debug: dump every llama-server request as JSON into this directory (unset = off).
# LLAMA_PAYLOAD_DUMP_DIR=data/llm_payloads

# Execution Flags
LLAMA_N_GPU_LAYERS=99
LLAMA_USE_MMAP=false

# Context Limits (Crucial for VRAM KV Cache budgeting)
LLAMA_CTX_SIZE_MAIN=32768
LLAMA_CTX_SIZE_FAST=8192

# Model Routing (Section 2 of Build plan)
MAIN_MODEL=Qwen3.5-9B-UD-Q3_K_XL
FAST_MODEL=Qwen3.5-4B-UD-Q4_K_XL
VISION_MODEL=
# Vision: an mmproj-*.gguf sitting in the same folder as the selected model is passed to
# llama-server as --mmproj automatically, so image attachments are seen rather than just stored.
# Set LLAMA_MMPROJ_ENABLED=false to stay text-only (frees the projector's VRAM);
# LLAMA_MMPROJ_OFFLOAD=false keeps the projector on the CPU.
LLAMA_MMPROJ_ENABLED=true
LLAMA_MMPROJ_OFFLOAD=true
# Free VRAM a launch keeps in hand; if a configuration does not fit, the projector,
# then half the context, then (main only) the fast model are tried, and the step is announced.
LLAMA_LAUNCH_VRAM_RESERVE_MB=384
# Image captioner sidecar: a small CPU-only vision model (SmolVLM) on its own port that describes
# image attachments for any model that cannot see them (text-only GGUF, Heavy Mode, a launch that
# had to drop its projector). Cold by default; started on the first image, stopped when idle.
CAPTIONER_ENABLED=true
CAPTIONER_MODEL_PATH=models/captioner/SmolVLM-500M-Instruct-Q8_0.gguf
CAPTIONER_PORT=8002
CAPTIONER_IDLE_SECONDS=300
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
RERANKER_MODEL=Qwen3-Reranker-0.6B

# App & Database
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/jarvis_memory.db
WORKSPACE_PATH=./workspace
TERMINAL_ENABLED=false
WEB_SEARCH_ENABLED=false
MAX_UPLOAD_SIZE_MB=50


# Resource Governor V2
GOVERNOR_ENABLED=true
GOVERNOR_POLL_INTERVAL=1.0
GOVERNOR_GPU_THRESHOLD=88.0
GOVERNOR_VRAM_THRESHOLD=92.0
GOVERNOR_CPU_THRESHOLD=95.0
GOVERNOR_RAM_THRESHOLD=98.5
# VRAM beyond Jarvis's own model before it counts as an external workload (a normal desktop is 1-2 GB).
GOVERNOR_EXTERNAL_VRAM_FLOOR_MB=2048
# Growth of the external share beyond its level at launch before the model yields the card.
GOVERNOR_EXTERNAL_VRAM_GROWTH_MB=1024

# Voice / TTS Output
# Spoken replies: Kokoro-82M on the CPU (fully local, no VRAM, ~0.4 GB RAM; files under
# models/tts/kokoro/ from github.com/thewh1teagle/kokoro-onnx releases, model-files-v1.0).
# "edge" is Microsoft's cloud voice; with kokoro selected and its files missing, speech is
# skipped unless VOICE_TTS_CLOUD_FALLBACK=true.
VOICE_TTS_BACKEND=kokoro
VOICE_TTS_CLOUD_FALLBACK=false
KOKORO_SPEED=1.0

# Compaction triggers, sized to the 32k main window.
MEMORY_MAX_CONTEXT_TOKENS=24000
MEMORY_MAX_MESSAGE_COUNT=60

# Context Engine & RAG (CPU-Only)
# Embedding sidecar: a small embedding GGUF served by llama-server on the CPU (port 8003),
# started on the first vector and stopped after the idle window. Without it (disabled, or no
# model file) vectors are a hashed bag of words with no semantic signal, so no floor applies.
RAG_EMBEDDING_SIDECAR_ENABLED=true
RAG_EMBEDDING_MODEL_PATH=models/embeddings/nomic-embed-text-v1.5.Q8_0.gguf
RAG_EMBEDDING_PORT=8003
RAG_EMBEDDING_IDLE_SECONDS=300
RAG_EMBEDDING_POOLING=mean
# nomic-embed's task prefixes; another model may want different ones (or none).
RAG_EMBEDDING_QUERY_PREFIX="search_query: "
RAG_EMBEDDING_DOCUMENT_PREFIX="search_document: "
# Relevance cuts on the cosine score (nomic scale, calibrated on this repo's code): nothing
# below the floor, nothing more than the gap under the best chunk, and nothing at all when
# the top six are within the peak of each other (the query has no target in the workspace).
RAG_MIN_RELEVANCE=0.62
RAG_RELEVANCE_GAP=0.15
RAG_MIN_PEAK=0.04
RAG_DEVICE=cpu
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=128
RAG_TOP_K=5

# Context Manager Budgeting & KV Cache Protection
CONTEXT_RESERVED_OUTPUT_TOKENS=2048
CONTEXT_TIER2_MAX_ATTACHMENT_TOKENS=8000
CONTEXT_TIER3_MAX_CHUNKS=5
CONTEXT_TIER4_MAX_MESSAGES=60
CONTEXT_INCLUDE_SUMMARY=true

# Seconds an unanswered confirmation stays valid before Jarvis says it timed out (0 = never).
CONFIRMATION_TIMEOUT_SECONDS=90
# Tool execution: per-call timeout (some tools have their own longer limit) and the cap on how
# much of a tool result the model sees (head + tail are kept, the middle is elided).
TOOL_DEFAULT_TIMEOUT_SECONDS=60
TOOL_RESULT_MAX_CHARS=12000
