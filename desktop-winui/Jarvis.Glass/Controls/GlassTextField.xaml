<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis_Glass.GlassTextField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="220"
    MinHeight="40">
    <!--
        The slab is a renderer shape (see GlassToggle.xaml); the TextBox is real WinUI input
        sitting on top of it, stripped of every background/border WinUI would otherwise paint in
        its rest/hover/focus states so the glass beneath is all that shows.
    -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlForeground" Color="White" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="White" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8CFFFFFF" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#A0FFFFFF" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#70FFFFFF" />
        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
    </UserControl.Resources>
    <Grid x:Name="Root" Background="Transparent">
        <!--
            WinUI 3's TextBox top-aligns its text and ignores VerticalContentAlignment, so the box
            is centred as a whole and the text pushed down inside it with top-only padding (the
            box grows by the padding and re-centres, so the net shift is half of it).
        -->
        <TextBox x:Name="Input"
                 VerticalAlignment="Center"
                 Padding="16,8,16,0"
                 MinHeight="0"
                 FontSize="14"
                 BorderThickness="0"
                 Background="Transparent"
                 TextWrapping="NoWrap"
                 AcceptsReturn="False"
                 KeyDown="Input_KeyDown"
                 GotFocus="Input_GotFocus"
                 LostFocus="Input_LostFocus"
                 TextChanged="Input_TextChanged" />
    </Grid>
</UserControl>
