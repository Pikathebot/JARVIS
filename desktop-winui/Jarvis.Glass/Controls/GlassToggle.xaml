<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis_Glass.GlassToggle"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="56"
    Height="32">
    <!--
        Draws nothing itself: the track and thumb are glass shapes rendered by GlassRenderer
        (published from code-behind), so the only XAML here is a hit-testable transparent surface.
        Background="Transparent" (not null) is what makes XAML hit-test it at all.
    -->
    <Grid x:Name="Root" Background="Transparent" />
</UserControl>
