<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis_GlassLab.GlassButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="96"
    Height="40">
    <!--
        The glass slab is a renderer shape (see GlassToggle.xaml); only the label lives in XAML,
        sitting above the glass. It scales with the press lift so it reads as part of the slab.
    -->
    <Grid x:Name="Root" Background="Transparent" Padding="18,0">
        <TextBlock x:Name="Label"
                   Foreground="White"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextLineBounds="Tight"
                   Margin="0,1,0,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <ScaleTransform x:Name="LabelScale" />
            </TextBlock.RenderTransform>
        </TextBlock>
    </Grid>
</UserControl>
