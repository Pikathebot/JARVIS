<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis_GlassLab.GlassButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="96"
    Height="40">
    <!--
        Slab and caption are both drawn by the renderer (the caption as GlassText on the slab's
        layer); this is only the transparent hit-test surface for the pointer handlers.
    -->
    <Grid x:Name="Root" Background="Transparent" />
</UserControl>
