<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis_GlassLab.GlassSegmented"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="36">
    <!--
        Track and selected pill are renderer shapes; only the labels live here, one equal column
        per segment (built in code-behind from Items). Background="Transparent" so it hit-tests.
    -->
    <Grid x:Name="Root" Background="Transparent" />
</UserControl>
