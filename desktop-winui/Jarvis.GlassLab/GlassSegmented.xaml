<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jarvis_GlassLab.GlassSegmented"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="36">
    <!--
        Track, selected pill AND the labels are all drawn by the renderer (the labels as GlassText
        under the pill so the lens bends them); nothing lives here but a transparent hit-test
        surface for the pointer handlers.
    -->
    <Grid x:Name="Root" Background="Transparent" />
</UserControl>
