<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jarvis_GlassLab.ControlOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jarvis_GlassLab">
    <Grid x:Name="RootGrid" Background="Transparent">
        <!--
            No XAML background: the card is a frosted glass shape published to the renderer from
            code-behind (see PublishCardShape). Anything painted here would sit ON TOP of the glass
            controls inside it (the old #CC141821 fill was dimming the toggle underneath).
        -->
        <StackPanel
            x:Name="Card"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="24,24,0,0"
            Spacing="8"
            Padding="12"
            Background="Transparent"
            Width="300">
            <Button x:Name="TestButton"
                    Content="GlassLab test button"
                    Click="TestButton_Click" />

            <!--
                Toggles GlassRenderer.Profile between Squircle (panels) and Lip (kube.io's
                switch/slider bezel: convex outside, concave middle). See BezelProfileMath.cs.
            -->
            <ToggleSwitch x:Name="LipProfileToggle"
                          Header="Lip bezel profile (kube.io switch)"
                          OffContent="Squircle"
                          OnContent="Lip"
                          Toggled="LipProfileToggle_Toggled" />

            <StackPanel Spacing="4">
                <TextBlock Text="Bezel width" Foreground="White" FontSize="12" />
                <Slider x:Name="BezelWidthSlider"
                        Minimum="4"
                        Maximum="120"
                        StepFrequency="1"
                        ValueChanged="BezelWidthSlider_ValueChanged" />
            </StackPanel>

            <!-- The first real liquid-glass control: track + thumb are shapes drawn by the renderer. -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:GlassToggle x:Name="DemoToggle" Toggled="DemoToggle_Toggled" />
                <TextBlock x:Name="DemoToggleLabel" Text="Glass toggle: off" Foreground="White" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Toggle material tuning: rows are generated in code-behind from a table. -->
            <TextBlock Text="Toggle material" Foreground="#AAFFFFFF" FontSize="11" Margin="0,6,0,0" />
            <StackPanel x:Name="TuningPanel" Spacing="2" />

            <StackPanel Spacing="4">
                <TextBlock Text="Corner radius" Foreground="White" FontSize="12" />
                <Slider x:Name="CornerRadiusSlider"
                        Minimum="0"
                        Maximum="300"
                        StepFrequency="1"
                        ValueChanged="CornerRadiusSlider_ValueChanged" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
