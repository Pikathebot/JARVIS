<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jarvis_GlassLab.ControlOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jarvis_GlassLab">
    <Grid x:Name="RootGrid" Background="Transparent">
        <!--
            No XAML background: the card is a frosted glass shape published to the renderer from
            code-behind (see PublishCardShape). Anything painted here would sit ON TOP of the glass
            controls inside it (the old #CC141821 fill was dimming the toggle underneath).
        -->
        <StackPanel
            x:Name="Card"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="24,24,0,0"
            Spacing="8"
            Padding="12"
            Background="Transparent"
            Width="560">
            <Button x:Name="TestButton"
                    Content="GlassLab test button"
                    Click="TestButton_Click" />

            <!-- The first real liquid-glass control: track + thumb are shapes drawn by the renderer. -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:GlassToggle x:Name="DemoToggle" Toggled="DemoToggle_Toggled" />
                <TextBlock x:Name="DemoToggleLabel" Text="Glass toggle: off" Foreground="White" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:GlassSlider x:Name="DemoSlider" ValueChanged="DemoSlider_ValueChanged" />
                <TextBlock x:Name="DemoSliderLabel" Text="35%" Foreground="White" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Glass buttons: clear pill with a lens rim, and the accent-filled variant. -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:GlassButton x:Name="DemoButton" Text="Glass" Click="DemoButton_Click" />
                <local:GlassButton x:Name="DemoAccentButton" Text="Accent" IsAccent="True" Click="DemoButton_Click" />
                <TextBlock x:Name="DemoButtonLabel" Text="clicks: 0" Foreground="White" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Glass text field: a real TextBox on a glass pill; focus lifts it. -->
            <local:GlassTextField x:Name="DemoTextField" Placeholder="Ask Jarvis..." HorizontalAlignment="Stretch" />

            <!-- Segmented control: grey track, white pill that lifts into glass while it slides. -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <local:GlassSegmented x:Name="DemoSegmented" Items="Artifacts|Files|Context|Activity" Width="360" SelectionChanged="DemoSegmented_SelectionChanged" />
                <TextBlock x:Name="DemoSegmentedLabel" Text="0" Foreground="White" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Toggle material tuning: rows are generated in code-behind from a table. -->
            <Grid Margin="0,6,0,0">
                <TextBlock Text="Toggle material" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center" />
                <Button x:Name="ResetTuningButton" Content="Reset to defaults" FontSize="11" Padding="8,2" HorizontalAlignment="Right" Click="ResetTuningButton_Click" />
            </Grid>
            <Grid x:Name="TuningPanel" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TuningColumnLeft" Spacing="2" />
                <StackPanel x:Name="TuningColumnRight" Grid.Column="1" Spacing="2" />
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock Text="Corner radius" Foreground="White" FontSize="12" />
                <Slider x:Name="CornerRadiusSlider"
                        Minimum="0"
                        Maximum="300"
                        StepFrequency="1"
                        ValueChanged="CornerRadiusSlider_ValueChanged" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
