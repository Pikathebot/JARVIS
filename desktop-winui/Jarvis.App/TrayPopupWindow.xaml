<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Jarvis_App.TrayPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Jarvis"
    mc:Ignorable="d">

    <!--
        The tray icon's right-click popup (design: "Jarvis Tray Popup" canvas, approved 2026-10-20).
        Plain XAML on the system acrylic, not liquid glass: a glass window must be capturable and
        renders every frame, which is too much for a menu that lives a few seconds.
    -->
    <Grid x:Name="Root" Padding="8" RowSpacing="4" KeyDown="Root_KeyDown">
        <Grid.Resources>
            <Style x:Key="TrayRow" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Who, and what state it is in -->
        <Grid Grid.Row="0" Padding="12,10,12,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="{ThemeResource MarkSource}" Width="32" Height="32" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Jarvis" Style="{StaticResource HeadlineText}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource StatusNeutralBrush}" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryFootnoteText}" Text="Connecting..." TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- The numbers the governor watches -->
        <StackPanel Grid.Row="1" Margin="4,0,4,4" Padding="12" Spacing="8" CornerRadius="10" Background="{ThemeResource FillTertiaryBrush}">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                </Grid.RowDefinitions>
                <TextBlock Text="VRAM" Style="{StaticResource SecondaryFootnoteText}" />
                <TextBlock x:Name="VramText" Style="{StaticResource DataText}" HorizontalAlignment="Right" Text="—" />
                <Grid Grid.Row="1" x:Name="VramTrack" CornerRadius="3" Background="{ThemeResource MeterTrackBrush}">
                    <Border x:Name="VramFill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{ThemeResource MeterNormalBrush}" />
                </Grid>
            </Grid>
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                </Grid.RowDefinitions>
                <TextBlock Text="RAM" Style="{StaticResource SecondaryFootnoteText}" />
                <TextBlock x:Name="RamText" Style="{StaticResource DataText}" HorizontalAlignment="Right" Text="—" />
                <Grid Grid.Row="1" x:Name="RamTrack" CornerRadius="3" Background="{ThemeResource MeterTrackBrush}">
                    <Border x:Name="RamFill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="{ThemeResource GrayBrush}" />
                </Grid>
            </Grid>
        </StackPanel>

        <!-- Switches: each names its current state -->
        <Grid Grid.Row="2" Padding="12,4" ColumnSpacing="12" MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="GameIcon" Style="{StaticResource JarvisIcon}" Glyph="&#xE7FC;" Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Game mode" Style="{StaticResource BodyText}" />
                <TextBlock x:Name="GameSub" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch x:Name="GameToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Margin="0,0,-8,0"
                          AutomationProperties.Name="Game mode" Toggled="GameToggle_Toggled" />
        </Grid>
        <Grid Grid.Row="3" Padding="12,4" ColumnSpacing="12" MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xEA18;" Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Governor" Style="{StaticResource BodyText}" />
                <TextBlock x:Name="GovSub" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch x:Name="GovToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Margin="0,0,-8,0"
                          AutomationProperties.Name="Governor" Toggled="GovToggle_Toggled" />
        </Grid>

        <Rectangle Grid.Row="4" Height="1" Margin="12,4" Fill="{ThemeResource SeparatorBrush}" />

        <Button Grid.Row="5" Style="{StaticResource TrayRow}" Click="Open_Click">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE8A7;" FontSize="16" />
                <TextBlock Grid.Column="1" Text="Open Jarvis" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Button Grid.Row="6" Style="{StaticResource TrayRow}" Click="Hud_Click">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE7F4;" FontSize="16" />
                <TextBlock Grid.Column="1" Text="Show HUD" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Ctrl+Shift+J" Style="{StaticResource DataText}" Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Button x:Name="FreeVramButton" Grid.Row="7" Style="{StaticResource TrayRow}" Click="FreeVram_Click">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE950;" FontSize="16" />
                <TextBlock Grid.Column="1" Text="Free VRAM" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <TextBlock x:Name="FreeVramHint" Grid.Column="2" Style="{StaticResource SecondaryFootnoteText}" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <Button Grid.Row="8" Style="{StaticResource TrayRow}" Click="Settings_Click">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE713;" FontSize="16" />
                <TextBlock Grid.Column="1" Text="Settings" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
            </Grid>
        </Button>

        <Rectangle Grid.Row="9" Height="1" Margin="12,4" Fill="{ThemeResource SeparatorBrush}" />

        <Button Grid.Row="10" Style="{StaticResource TrayRow}" Click="Quit_Click">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE7E8;" FontSize="16" />
                <TextBlock Grid.Column="1" Text="Quit Jarvis" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
            </Grid>
        </Button>
    </Grid>
</Window>
