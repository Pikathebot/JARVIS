<?xml version="1.0" encoding="utf-8" ?>
<!--
    The design system's type scale (Jarvis design system v2, tokens.json "type"), shape and
    control sizes. Colours are not here: they come from JarvisTheme's theme dictionaries
    ({ThemeResource LabelBrush} and friends), built from Jarvis.Glass's JarvisPalette.

    Every text style defaults to LabelBrush; set Foreground on the element for another colour.
    Nothing in Jarvis is smaller than 11px (CaptionText).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Families: the Windows system face in its optical sizes, and Cascadia Mono. -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SmallFontFamily">Segoe UI Variable Small, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="JarvisTextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFontFamily}" />
        <Setter Property="Foreground" Value="{ThemeResource LabelBrush}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextLineBounds" Value="Full" />
    </Style>

    <!-- Titles (display optical size from 20px up). -->
    <Style x:Key="LargeTitleText" TargetType="TextBlock" BasedOn="{StaticResource JarvisTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="34" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Title1Text" TargetType="TextBlock" BasedOn="{StaticResource JarvisTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Title2Text" TargetType="TextBlock" BasedOn="{StaticResource JarvisTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="25" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Title3Text" TargetType="TextBlock" BasedOn="{StaticResource JarvisTextBase}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Text. -->
    <Style x:Key="HeadlineText" TargetType="TextBlock" BasedOn="{StaticResource JarvisTextBase}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="MessageText" TargetType="TextBlock" BasedOn="{StaticResource JarvisTextBase}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource JarvisTextBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style x:Key="BodyEmphasisText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Section headers: sentence case, label-secondary. -->
    <Style x:Key="SectionHeaderText" TargetType="TextBlock" BasedOn="{StaticResource BodyEmphasisText}">
        <Setter Property="Foreground" Value="{ThemeResource LabelSecondaryBrush}" />
    </Style>
    <Style x:Key="FootnoteText" TargetType="TextBlock" BasedOn="{StaticResource JarvisTextBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
    </Style>
    <!-- Field labels above inputs, toggle captions, hints. -->
    <Style x:Key="SecondaryFootnoteText" TargetType="TextBlock" BasedOn="{StaticResource FootnoteText}">
        <Setter Property="Foreground" Value="{ThemeResource LabelSecondaryBrush}" />
    </Style>

    <!-- Small (the 11px floor). -->
    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource JarvisTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource SmallFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="14" />
    </Style>
    <Style x:Key="CaptionEmphasisText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Data: measured numbers, tabular. -->
    <Style x:Key="MetricText" TargetType="TextBlock" BasedOn="{StaticResource JarvisTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DataText" TargetType="TextBlock" BasedOn="{StaticResource JarvisTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource LabelSecondaryBrush}" />
    </Style>
    <Style x:Key="CodeBlockText" TargetType="TextBlock" BasedOn="{StaticResource JarvisTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="CodeInlineText" TargetType="TextBlock" BasedOn="{StaticResource JarvisTextBase}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <!-- Icons: Segoe Fluent Icons at icon-16 by default. -->
    <Style x:Key="JarvisIcon" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Radii (concentric: child = parent - inset). Doubles for GlassSlab.SlabCornerRadius. -->
    <x:Double x:Key="RadiusSmall">6</x:Double>
    <x:Double x:Key="RadiusRow">10</x:Double>
    <x:Double x:Key="RadiusCard">14</x:Double>
    <x:Double x:Key="RadiusPanel">18</x:Double>
    <x:Double x:Key="RadiusSheet">26</x:Double>
    <CornerRadius x:Key="SmallCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="RowCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>

    <!-- Control heights. -->
    <x:Double x:Key="ControlSmall">28</x:Double>
    <x:Double x:Key="ControlMedium">36</x:Double>
    <x:Double x:Key="ControlLarge">44</x:Double>

</ResourceDictionary>
