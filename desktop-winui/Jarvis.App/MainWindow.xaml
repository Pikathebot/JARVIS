<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Jarvis_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Jarvis_App"
    xmlns:models="using:Jarvis.Core.Models"
    xmlns:views="using:Jarvis_App.Views"
    xmlns:glass="using:Jarvis_Glass"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Jarvis - Local AI Command Center"
    mc:Ignorable="d">

    <!--
        No system backdrop: the window is hosted by a GlassHost (see MainWindow.xaml.cs), which
        makes it transparent and renders every GlassSlab below as liquid glass behind it.
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Nothing is painted behind the panels: the window is fully transparent and the
            GlassHost's slabs are the only surfaces, over the live desktop.

            Layout (the design system's AppLayout card): the sidebar runs the full height,
            its header sitting in the caption row; the chat column's toolbar is clear-glass
            capsules in the caption row too (no header slab); under it one thick reading surface
            holds the transcript and the composer. The top 48 px drag the window except where a
            control sits (UpdateTitleBarRegions).
        -->
        <!--
            The traffic-light window buttons (PLAN 4.7d, designed on the canvas 2026-10-01):
            yellow minimize, green maximize, red close, in the top-right corner where the system
            buttons were. They are drawn here, but their rectangles are the window's Minimize /
            Maximize / Close non-client regions, so Windows does the work, including Snap
            layouts on green, and reports hover and press back (MainWindow.WindowControls.cs).
        -->
        <StackPanel x:Name="WindowControls" Grid.Row="0" Canvas.ZIndex="100" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
            <Grid x:Name="MinimizeHit" Width="23" Height="28" Background="Transparent" AutomationProperties.Name="Minimize">
                <Ellipse x:Name="MinimizeDot" Width="14" Height="14" StrokeThickness="0" />
                <Ellipse x:Name="MinimizePress" Width="14" Height="14" Fill="Black" Opacity="0" IsHitTestVisible="False" />
                <Viewbox x:Name="MinimizeGlyph" Width="14" Height="14" Opacity="0" IsHitTestVisible="False">
                    <Canvas Width="12" Height="12">
                        <Path x:Name="MinimizeLine" Data="M3.3,6 L8.7,6" Stroke="{ThemeResource WindowControlGlyphBrush}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Grid>
            <Grid x:Name="MaximizeHit" Width="23" Height="28" Background="Transparent" AutomationProperties.Name="Maximize">
                <Ellipse x:Name="MaximizeDot" Width="14" Height="14" StrokeThickness="0" />
                <Ellipse x:Name="MaximizePress" Width="14" Height="14" Fill="Black" Opacity="0" IsHitTestVisible="False" />
                <Viewbox x:Name="MaximizeGlyph" Width="14" Height="14" Opacity="0" IsHitTestVisible="False">
                    <Canvas Width="12" Height="12">
                        <Path x:Name="MaximizeOut" Data="M3.4,3.4 L7,3.4 L3.4,7 Z M8.6,8.6 L5,8.6 L8.6,5 Z" Fill="{ThemeResource WindowControlGlyphBrush}" />
                        <Path x:Name="MaximizeIn" Data="M5.6,5.6 L2.6,5.6 L5.6,2.6 Z M6.4,6.4 L9.4,6.4 L6.4,9.4 Z" Fill="{ThemeResource WindowControlGlyphBrush}" />
                    </Canvas>
                </Viewbox>
            </Grid>
            <Grid x:Name="CloseHit" Width="23" Height="28" Background="Transparent" AutomationProperties.Name="Close">
                <Ellipse x:Name="CloseDot" Width="14" Height="14" StrokeThickness="0" />
                <Ellipse x:Name="ClosePress" Width="14" Height="14" Fill="Black" Opacity="0" IsHitTestVisible="False" />
                <Viewbox x:Name="CloseGlyph" Width="14" Height="14" Opacity="0" IsHitTestVisible="False">
                    <Canvas Width="12" Height="12">
                        <Path x:Name="CloseCross" Data="M3.9,3.9 L8.1,8.1 M8.1,3.9 L3.9,8.1" Stroke="{ThemeResource WindowControlGlyphBrush}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </StackPanel>

        <Grid x:Name="BodyGrid" Grid.Row="0" Grid.RowSpan="2" Padding="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: the navigation layer, the one big glass pane. At narrow widths (or when
                 hidden from the toolbar) it leaves the grid and floats over the chat (see
                 ApplyResponsiveLayout). Rows are plain XAML on the pane, not glass. -->
            <glass:GlassSlab x:Name="SidebarSlab" Grid.Column="0" Margin="0,0,8,0" SlabCornerRadius="{StaticResource RadiusPanel}">
                <!--
                    Header / list / footer rows rather than one StackPanel: a ListView in a
                    StackPanel is measured with infinite height and realises every row. In a *
                    row the list virtualises to what is visible.
                -->
                <Grid Padding="10" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="8">
                        <Grid Height="32" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Source="{ThemeResource MarkSource}" Width="24" Height="24" VerticalAlignment="Center" />
                                <TextBlock Text="Jarvis" Style="{StaticResource Title3Text}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="ComposeButton" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right"
                                    ToolTipService.ToolTip="New chat (Ctrl+N)" Click="NewChat_Click">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="N" />
                                </Button.KeyboardAccelerators>
                                <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE70F;" />
                            </Button>
                        </Grid>

                        <!--
                            The two spaces. Freeform: plain conversation, no project, no working
                            directory, no retrieval. Workspace: bound to the project picked below.
                            Each keeps its own session list and last conversation.
                        -->
                        <glass:GlassSegmented x:Name="SpaceSwitch" Items="Freeform|Workspace" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="SpaceSwitch_SelectionChanged" />

                        <!--
                            Workspace picker: a glass button that drops a floating glass card
                            (WorkspaceDropdown, at the root so it floats over the sidebar);
                            a ComboBox's popup is painted above the window, where the glass
                            can't reach.
                        -->
                        <glass:GlassButton x:Name="WorkspaceButton" Text="Default Workspace" HorizontalAlignment="Stretch" Click="WorkspaceButton_Click" />

                        <!-- Search: filters the list below by title and last message. -->
                        <TextBox x:Name="SessionSearch" PlaceholderText="Search chats" Height="32" MinHeight="0" Padding="34,6,10,0"
                                 FontSize="13" CornerRadius="{StaticResource RowCornerRadius}" BorderThickness="0"
                                 TextChanged="SessionSearch_TextChanged">
                            <TextBox.Resources>
                                <StaticResource x:Key="TextControlBackground" ResourceKey="FillTertiaryBrush" />
                                <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="FillSecondaryBrush" />
                                <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="FillSecondaryBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="PlaceholderBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="PlaceholderBrush" />
                                <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="PlaceholderBrush" />
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                    <FontIcon x:Name="SessionSearchIcon" Grid.Row="0" Style="{StaticResource JarvisIcon}" Glyph="&#xE721;" FontSize="14"
                              Foreground="{ThemeResource PlaceholderBrush}" IsHitTestVisible="False"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,9" />

                    <!--
                        Sessions grouped by date (Today, Yesterday, Previous 7 days, Older), as
                        plain rows: the active one on fill-secondary, "..." (delete) on hover.
                        ItemsSource is a grouped CollectionViewSource built in code
                        (RebuildSessionGroups), filtered by the search box.
                    -->
                    <ListView
                        x:Name="SessionsList"
                        Grid.Row="1"
                        Margin="-4,0,-4,0"
                        Background="Transparent"
                        SelectionMode="None">
                        <ListView.Resources>
                            <!-- Group headers are plain labels, without WinUI's rule under them. -->
                            <SolidColorBrush x:Key="ListViewHeaderItemDividerStroke" Color="Transparent" />
                        </ListView.Resources>
                        <!-- No theme transitions: they animate on the compositor, where the
                             pane's glass can't follow. Page motion is MainWindow.Motion's. -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.GroupStyle>
                            <GroupStyle HidesIfEmpty="True">
                                <GroupStyle.HeaderContainerStyle>
                                    <Style TargetType="ListViewHeaderItem">
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="12,10,0,4" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </GroupStyle.HeaderContainerStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="local:SessionGroup">
                                        <TextBlock Text="{x:Bind Key}" Style="{StaticResource SecondaryFootnoteText}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Session">
                                <Grid
                                    Height="34"
                                    Padding="8,0,4,0"
                                    ColumnSpacing="8"
                                    CornerRadius="{StaticResource RowCornerRadius}"
                                    Background="Transparent"
                                    Tapped="SessionItem_Tapped"
                                    PointerEntered="SessionRow_PointerEntered"
                                    PointerExited="SessionRow_PointerExited"
                                    Tag="{x:Bind}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE8BD;" Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind local:MainWindow.SessionRowLabel(SessionId, LastMessage)}"
                                        Style="{StaticResource BodyText}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="2"
                                        Width="28"
                                        Height="28"
                                        Style="{StaticResource IconButtonStyle}"
                                        Opacity="0"
                                        ToolTipService.ToolTip="More"
                                        Tag="{x:Bind}">
                                        <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE712;" FontSize="14" Foreground="{ThemeResource LabelSecondaryBrush}" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="Delete" Tag="{x:Bind}" Click="DeleteSession_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource SeparatorBrush}" Padding="0,6,0,0">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34" Padding="8,0"
                                Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource RowCornerRadius}"
                                Click="Settings_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE713;" Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Settings" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </glass:GlassSlab>

            <!-- Chat column: the toolbar in the caption row, then the reading surface. -->
            <Grid x:Name="ChatColumn" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    Toolbar: clear-glass capsules floating in the caption row, no slab behind
                    them. The right margin leaves the system caption buttons their room; it drops
                    to 0 while the inspector is docked, when they sit over the inspector's column.
                -->
                <Grid x:Name="TitleBarRow" Grid.Row="0" Margin="0,0,85,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <glass:GlassSlab x:Name="SidebarCapsule" Grid.Column="0" Material="Clear" VerticalAlignment="Center"
                                     SlabCornerRadius="20" Padding="4">
                        <Button x:Name="SidebarToggleButton" Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Sidebar" Click="SidebarToggle_Click">
                            <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE700;" />
                        </Button>
                    </glass:GlassSlab>

                    <!-- Status pill: model + VRAM; opens the status popover. Status is always an
                         icon, a word and a colour (UpdateStatusPill). -->
                    <glass:GlassSlab x:Name="StatusCapsule" Grid.Column="2" Material="Clear" VerticalAlignment="Center"
                                     SlabCornerRadius="20" Padding="4">
                        <Button x:Name="StatusPillButton" Height="32" Padding="10,0,10,0" Background="Transparent" BorderThickness="0"
                                CornerRadius="16" ToolTipService.ToolTip="Model and hardware" Click="StatusPill_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="GovernorPillIcon" Style="{StaticResource JarvisIcon}" Glyph="&#xEA39;" FontSize="14" Foreground="{ThemeResource StatusErrorBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="GovernorPillText" Text="Offline" Style="{StaticResource FootnoteText}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusVramText" Text="" Style="{StaticResource DataText}" VerticalAlignment="Center" />
                                <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </glass:GlassSlab>

                    <glass:GlassSlab x:Name="ToolsCapsule" Grid.Column="3" Material="Clear" VerticalAlignment="Center"
                                     SlabCornerRadius="20" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <!-- Ephemeral: an off-the-record scratchpad in either space; nothing is stored. -->
                            <Button x:Name="EphemeralButton" Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Ephemeral chat: nothing is saved" Click="EphemeralButton_Click">
                                <FontIcon x:Name="EphemeralIcon" Style="{StaticResource JarvisIcon}" Glyph="&#xED1A;" />
                            </Button>
                            <Button x:Name="HudButton" Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="HUD (Ctrl+Shift+J)" Click="HudButton_Click">
                                <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE8A7;" />
                            </Button>
                            <Button x:Name="PanelButton" Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Inspector" Click="ToggleRightPanel_Click">
                                <FontIcon x:Name="PanelIcon" Style="{StaticResource JarvisIcon}" Glyph="&#xE90D;" />
                            </Button>
                        </StackPanel>
                    </glass:GlassSlab>
                </Grid>

                <!--
                    The reading surface: one thick slab. Nothing on it is glass except the
                    composer's field: no glass on glass behind the text.
                -->
                <glass:GlassSlab x:Name="MessagesSlab" Grid.Row="1" Margin="0,8,0,0" Material="Thick" SlabCornerRadius="{StaticResource RadiusPanel}">
                    <Grid x:Name="SurfaceContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <InfoBar
                            x:Name="ErrorBanner"
                            Grid.Row="0"
                            Severity="Error"
                            IsOpen="False"
                            MaxWidth="720"
                            Margin="16,12,16,0"
                            CornerRadius="10" />
                        <!-- A 720 px reading column, centred; the scroll bar stays at the surface's edge. -->
                        <ListView
                            x:Name="MessageList"
                            Grid.Row="1"
                            Padding="24,16,24,8"
                            SelectionMode="None"
                            IsSwipeEnabled="False"
                            ItemsSource="{x:Bind ChatViewModel.Messages}">
                            <!-- No theme transitions: the default entrance slid each row's XAML
                                 on the compositor while any glass sat still. -->
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MaxWidth" Value="720" />
                                    <Setter Property="Width" Value="720" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <!--
                                    No x:DataType/x:Bind here deliberately: MessageBubbleControl
                                    renders via classic Binding/DataContext (see its code-behind),
                                    since it must re-render markdown on every streamed token
                                    change, not just once at bind time.
                                -->
                                <DataTemplate>
                                    <views:MessageBubbleControl HorizontalAlignment="Stretch" Loaded="MessageBubble_Loaded" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Composer: one capsule. The glass field is the capsule; attach, mic and
                             send sit over its ends (InputPadding keeps the text clear of them). -->
                        <StackPanel x:Name="ComposerArea" Grid.Row="2" MaxWidth="720" Margin="24,8,24,12" Spacing="6">
                            <ItemsControl x:Name="AttachmentChips">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <!-- Only shown while an image is attached: says whether the model will
                                 actually see it, or have it described by the captioner. -->
                            <TextBlock x:Name="VisionHint" Style="{StaticResource SecondaryFootnoteText}" Visibility="Collapsed" TextWrapping="Wrap" />
                            <Grid MinHeight="48">
                                <glass:GlassTextField
                                    x:Name="ComposerBox"
                                    MinHeight="48"
                                    InputPadding="48,8,92,0"
                                    VerticalAlignment="Stretch"
                                    Placeholder="Message Jarvis"
                                    AcceptsReturn="True"
                                    InputMaxHeight="160"
                                    InputKeyDown="ComposerBox_KeyDown" />
                                <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8"
                                        ToolTipService.ToolTip="Attach a file" Click="AttachFile_Click">
                                    <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE710;" />
                                </Button>
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,7">
                                    <Button x:Name="MicButton" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Talk to Jarvis" Click="MicButton_Click">
                                        <FontIcon x:Name="MicIcon" Style="{StaticResource JarvisIcon}" Glyph="&#xE720;" />
                                    </Button>
                                    <Button x:Name="SendButton" Width="34" Height="34" Padding="0" CornerRadius="17" BorderThickness="0"
                                            Background="{ThemeResource AccentFillBrush}" ToolTipService.ToolTip="Send (Enter)" Click="SendButton_Click">
                                        <Button.Resources>
                                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentBrush" />
                                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentFillBrush" />
                                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="FillSecondaryBrush" />
                                        </Button.Resources>
                                        <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE74A;" Foreground="{ThemeResource OnAccentBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <!-- Where the model runs; the voice state while the mic is on. -->
                            <TextBlock x:Name="ComposerCaption" Text="Runs on this PC · nothing leaves it" Style="{StaticResource CaptionText}"
                                       Foreground="{ThemeResource LabelTertiaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Awareness tray: floats bottom-right of the transcript. -->
                        <ContentControl
                            x:Name="AwarenessTrayHost"
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,12,8"
                            IsTabStop="False" />
                    </Grid>
                </glass:GlassSlab>
            </Grid>

            <!-- Inspector (the old right panel): closed until there is something to show. -->
            <glass:GlassSlab
                x:Name="RightPanel"
                Grid.Column="2"
                Margin="8,48,0,0"
                SlabCornerRadius="{StaticResource RadiusPanel}"
                Visibility="Collapsed">
                    <!--
                        Tabs are a GlassSegmented (labels rendered inside the glass, the pill
                        refracts them as it slides); the pages below are plain grids switched
                        by SelectedIndex in code-behind.
                    -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="16,10,8,0">
                            <TextBlock Text="Inspector" Style="{StaticResource HeadlineText}" VerticalAlignment="Center" />
                            <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" ToolTipService.ToolTip="Close" Click="ToggleRightPanel_Click">
                                <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource LabelSecondaryBrush}" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" Margin="12,8,12,0">
                            <glass:GlassSegmented x:Name="RightPanelTabs" Items="Artifacts|Files|Reasoning|Context|Activity" SelectionChanged="RightPanelTabs_SelectionChanged" />
                            <!-- Reasoning-is-streaming badge, top-right of the tab strip. -->
                            <Ellipse x:Name="ReasoningBadge" Width="6" Height="6" Fill="{ThemeResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid x:Name="ArtifactsPage" Visibility="Visible">
                            <Grid Padding="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button Content="Refresh" HorizontalAlignment="Stretch" Click="RefreshArtifacts_Click" />
                                <ListView
                                    x:Name="ArtifactsList"
                                    Grid.Row="1"
                                    MaxHeight="160"
                                    ItemsSource="{x:Bind RightPanelViewModel.Artifacts}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Artifact">
                                            <Grid Padding="8,6" Tapped="ArtifactItem_Tapped" Tag="{x:Bind}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Type}" Style="{StaticResource CaptionText}" Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
                                    <TextBlock
                                        x:Name="ArtifactContent"
                                        Text="{x:Bind RightPanelViewModel.SelectedContent, Mode=OneWay}"
                                        Style="{StaticResource CodeBlockText}"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </Grid>
                            </Grid>
                            <Grid x:Name="FilesPage" Visibility="Collapsed">
                            <Grid Padding="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button Content="Refresh" HorizontalAlignment="Stretch" Click="RefreshFiles_Click" />
                                <ListView
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    ItemsSource="{x:Bind RightPanelViewModel.Files}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProjectFile">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}" Padding="8,4" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                            </Grid>
                            <Grid x:Name="ReasoningPage" Visibility="Collapsed">
                            <ScrollViewer Padding="12">
                                <TextBlock x:Name="ReasoningText" Text="No reasoning for this turn yet."
                                           TextWrapping="Wrap" Style="{StaticResource DataText}" />
                            </ScrollViewer>
                            </Grid>
                            <Grid x:Name="ContextPage" Visibility="Collapsed">
                            <ScrollViewer Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="ContextBudgetHeader" Text="No turn yet" Style="{StaticResource HeadlineText}" />
                                    <Grid x:Name="ContextBudgetGrid" ColumnSpacing="8" RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="Tier1Text" Text="Tier1 System: —" Style="{StaticResource DataText}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="Tier2Text" Text="Tier2 User+Files: —" Style="{StaticResource DataText}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="Tier3Text" Text="Tier3 RAG: —" Style="{StaticResource DataText}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="Tier4Text" Text="Tier4 History: —" Style="{StaticResource DataText}" />
                                    </Grid>
                                    <TextBlock Text="Retrieved code chunks" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,0" />
                                    <ItemsControl x:Name="RetrievedChunksList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            </Grid>
                            <Grid x:Name="ActivityPage" Visibility="Collapsed">
                            <ScrollViewer Padding="12">
                                <ItemsControl x:Name="ActivityStepsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
            </glass:GlassSlab>
        </Grid>

        <!--
            Workspace dropdown: one frosted glass card (iOS search-suggestions style) floated
            under the workspace button; rows are plain text on the card, the active one lit.
            Positioned from code-behind when opened; light-dismissed by any press outside it.
        -->
        <!--
            No XAML fill on the card: the menu's labels are glass text (GlassSegmented), and a
            fill would sit above them. What would otherwise show through the card is the
            sidebar's plain-XAML text (the sessions header and rows): every slab's glass
            renders beneath all XAML, so those are hidden while the card is open instead
            (SetWorkspaceDropdownOpen).
        -->
        <glass:GlassSlab
            x:Name="WorkspaceDropdown"
            Grid.Row="0"
            Grid.RowSpan="2"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Material="Thick"
            SlabCornerRadius="{StaticResource RadiusSheet}"
            TintAmount="0.55"
            Frost="16"
            BezelWidth="8"
            Refraction="5"
            Specular="0.5"
            Shadow="0.4"
            ShadowRadius="24"
            ShadowOffsetY="8"
            Padding="6"
            MinWidth="220">
            <StackPanel Spacing="6">
                <!-- Rows + the sliding puck are the vertical segmented control; Items set from code. -->
                <glass:GlassSegmented x:Name="WorkspaceMenu" Orientation="Vertical" Items="Default Workspace" SelectionChanged="WorkspaceMenu_SelectionChanged" DragPullChanged="WorkspaceMenu_DragPullChanged" />
                <!-- Not a row of the menu: creating is an action, not a selection the puck should land on. -->
                <glass:GlassButton x:Name="NewWorkspaceButton" Text="New workspace" HorizontalAlignment="Stretch" Click="NewWorkspace_Click" />
            </StackPanel>
        </glass:GlassSlab>

        <!--
            Status popover: model, VRAM and GPU, the governor switch, the fast model, Free VRAM.
            Inline glass rather than a Flyout (popups paint above the window, where the glass
            can't reach). Positioned under the status pill from code; light-dismissed like the
            workspace dropdown. The transcript's XAML fades while it is open (SetStatusPopoverOpen),
            since glass can never frost the text beneath it.
        -->
        <glass:GlassSlab
            x:Name="StatusPopover"
            Grid.Row="0"
            Grid.RowSpan="2"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="320"
            Material="Thick"
            SlabCornerRadius="{StaticResource RadiusPanel}"
            Shadow="0.4"
            ShadowRadius="24"
            ShadowOffsetY="8"
            Padding="16">
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="PopoverStatusIcon" Style="{StaticResource JarvisIcon}" Glyph="&#xEA39;" Foreground="{ThemeResource StatusErrorBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="PopoverModelName" Grid.Column="1" Text="No model" Style="{StaticResource HeadlineText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock x:Name="PopoverStatusWord" Grid.Column="2" Text="Offline" Style="{StaticResource FootnoteText}" Foreground="{ThemeResource StatusErrorBrush}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="PopoverModelDetail" Text="main" Style="{StaticResource SecondaryFootnoteText}" TextTrimming="CharacterEllipsis" />

                <Grid Margin="0,10,0,0">
                    <TextBlock Text="VRAM" Style="{StaticResource FootnoteText}" />
                    <TextBlock x:Name="PopoverVramText" Text="—" Style="{StaticResource DataText}" HorizontalAlignment="Right" />
                </Grid>
                <Grid Height="6" CornerRadius="3" Background="{ThemeResource MeterTrackBrush}">
                    <Rectangle x:Name="PopoverVramBar" Fill="{ThemeResource MeterNormalBrush}" RadiusX="3" RadiusY="3" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="PopoverVramScale" ScaleX="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <TextBlock Text="GPU" Style="{StaticResource FootnoteText}" />
                    <TextBlock x:Name="PopoverGpuText" Text="—" Style="{StaticResource DataText}" HorizontalAlignment="Right" />
                </Grid>
                <Grid Height="6" CornerRadius="3" Background="{ThemeResource MeterTrackBrush}">
                    <Rectangle x:Name="PopoverGpuBar" Fill="{ThemeResource MeterNormalBrush}" RadiusX="3" RadiusY="3" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="PopoverGpuScale" ScaleX="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>

                <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource SeparatorBrush}" Margin="0,12,0,0" Padding="0,10,0,0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Governor" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Unloads the model when another app needs the GPU" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <glass:GlassToggle x:Name="GovernorToggle" Grid.Column="1" SwitchScale="0.75" IsOn="True" VerticalAlignment="Center" Toggled="GovernorToggle_Toggled" />
                    </Grid>
                </Border>
                <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource SeparatorBrush}" Margin="0,10,0,0" Padding="0,10,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Answer with" Style="{StaticResource BodyText}" />
                        <!-- Auto | Main | Fast, sent as the turn's model (ChatViewModel.ModelChoice). -->
                        <glass:GlassSegmented x:Name="ModelChoiceSwitch" Items="Auto|Main|Fast" HorizontalAlignment="Stretch" Margin="0,4,0,2" SelectionChanged="ModelChoiceSwitch_SelectionChanged" />
                        <TextBlock x:Name="ModelChoiceNote" Text="Quick turns run on the loaded model, thinking off" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PopoverFastModel" Text="—" Style="{StaticResource SecondaryFootnoteText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                    <glass:GlassButton Text="Free VRAM" Click="FreeVram_Click" />
                    <glass:GlassButton Text="Models…" Click="StatusModels_Click" />
                </StackPanel>
            </StackPanel>
        </glass:GlassSlab>

        <!--
            Startup card: shown while BackendHost brings uvicorn up. It arrives as clear glass and
            condenses (frost and tint spring in); the line under the wordmark fills on real steps
            (backend up, workspaces, sessions), not a timer. Then it swells and dissolves while
            the panels materialise one by one (MainWindow.Motion.cs). Static between steps (only
            the caption breathes, in XAML), so the wait costs no GPU.
        -->
        <Grid x:Name="StartupOverlay" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
            <glass:GlassSlab
                x:Name="StartupCard"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Material="Thick"
                SlabCornerRadius="{StaticResource RadiusSheet}"
                TintAmount="0.3"
                Frost="12"
                Padding="32,24,32,20">
                <StackPanel Spacing="10" Width="200">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Image Source="{ThemeResource MarkSource}" Width="34" Height="34" VerticalAlignment="Center" />
                        <TextBlock Text="Jarvis" Style="{StaticResource LargeTitleText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Progress: a fixed track; the fill is scaled from its left edge, never resized. -->
                    <Grid Height="2" CornerRadius="1" Background="{ThemeResource MeterTrackBrush}">
                        <Rectangle x:Name="StartupProgress" Fill="{ThemeResource AccentBrush}" RadiusX="1" RadiusY="1" RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="StartupProgressScale" ScaleX="0" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <TextBlock x:Name="StartupStatus" Text="Starting the backend" Style="{StaticResource SecondaryFootnoteText}" HorizontalAlignment="Center" />
                </StackPanel>
            </glass:GlassSlab>
        </Grid>

        <!-- Settings sheet overlay (see Views/SettingsPane.xaml); filled on demand by Settings_Click. -->
        <Grid x:Name="SettingsHost" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
