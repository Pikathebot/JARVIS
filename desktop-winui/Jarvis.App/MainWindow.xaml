<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Jarvis_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Jarvis_App"
    xmlns:models="using:Jarvis.Core.Models"
    xmlns:views="using:Jarvis_App.Views"
    xmlns:glass="using:Jarvis_Glass"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Jarvis - Local AI Command Center"
    mc:Ignorable="d">

    <!--
        No system backdrop: the window is hosted by a GlassHost (see MainWindow.xaml.cs), which
        makes it transparent and renders every GlassSlab below as liquid glass behind it.
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Nothing is painted behind the panels: the window is fully transparent and the
            GlassHost's slabs are the only surfaces, over the live desktop.
        -->

        <!-- Custom title bar: draggable region, app name left, window controls handled by AppWindow. -->
        <Grid x:Name="TitleBarRow" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                <!-- Only at narrow widths, where the sidebar is hidden and floats on demand. -->
                <Button x:Name="SidebarToggleButton" Content="☰" FontSize="14" Padding="8,2" Background="Transparent" BorderThickness="0"
                        Foreground="#06B6D4" Visibility="Collapsed" Click="SidebarToggle_Click" />
                <TextBlock
                    Text="JARVIS"
                    Foreground="#06B6D4"
                    FontWeight="SemiBold"
                    FontSize="13"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid x:Name="BodyGrid" Grid.Row="1" Padding="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: floating glass slab. At narrow widths it leaves the grid and floats over
                 the chat from the ☰ button (see ApplyResponsiveLayout). -->
            <glass:GlassSlab x:Name="SidebarSlab" Grid.Column="0" Margin="0,0,8,0" SlabCornerRadius="18">
                    <!--
                        Header / list / footer rows rather than one StackPanel: a ListView in a
                        StackPanel is measured with infinite height and realises every row. Each
                        row is a glass slab, so with hundreds of sessions that blew the scene's
                        shape budget (toggle thumbs vanished) and republished hundreds of slabs
                        per layout pass. In a * row the list virtualises to what is visible.
                    -->
                    <Grid Padding="16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Spacing="12">
                        <TextBlock Text="Jarvis" Foreground="White" FontSize="18" FontWeight="Bold" />

                        <!--
                            The two spaces. Freeform: plain conversation, no project, no working
                            directory, no retrieval. Workspace: bound to the project picked below.
                            Each keeps its own session list and last conversation.
                        -->
                        <glass:GlassSegmented x:Name="SpaceSwitch" Items="Freeform|Workspace" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="SpaceSwitch_SelectionChanged" />

                        <!--
                            Workspace picker: a glass button that drops a floating glass card
                            (WorkspaceDropdown, at the root so it floats over the sidebar);
                            a ComboBox's popup is painted above the window, where the glass
                            can't reach.
                        -->
                        <glass:GlassButton x:Name="WorkspaceButton" Text="Default Workspace" HorizontalAlignment="Stretch" Click="WorkspaceButton_Click" />

                        <glass:GlassButton Text="+ New Chat" IsAccent="True" HorizontalAlignment="Stretch" Click="NewChat_Click" />
                        <TextBlock x:Name="RecentSessionsHeader" Text="Recent Sessions" Foreground="#94A3B8" FontSize="12" Margin="0,12,0,0" />
                        </StackPanel>
                        <!--
                            Each session is a small glass row nested in the sidebar slab (auto
                            layer 2, clipped to the list). The active one is tinted accent from
                            code-behind (UpdateSessionHighlight) since the template can't see
                            ChatViewModel.
                        -->
                        <ListView
                            x:Name="SessionsList"
                            Grid.Row="1"
                            Background="Transparent"
                            SelectionMode="None"
                            ItemsSource="{x:Bind SessionsViewModel.Sessions}">
                            <!-- No theme transitions: they animate on the compositor, where the
                                 rows' glass can't follow. Page motion is MainWindow.Motion's. -->
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Session">
                                    <glass:GlassSlab
                                        SlabCornerRadius="10"
                                        TintAmount="0.14"
                                        Frost="0"
                                        BezelWidth="4"
                                        Refraction="2"
                                        Specular="0.35"
                                        Shadow="0"
                                        Padding="10,7"
                                        Tapped="SessionItem_Tapped"
                                        Loaded="SessionRow_Loaded"
                                        Tag="{x:Bind}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="{x:Bind local:MainWindow.SessionRowLabel(SessionId, LastMessage)}"
                                            Foreground="#CBD5E1"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Grid.Column="1"
                                            Content="✕"
                                            FontSize="10"
                                            Padding="4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Tag="{x:Bind}"
                                            Click="DeleteSession_Click" />
                                    </glass:GlassSlab>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Grid.Row="2" Spacing="12">
                        <glass:GlassButton Text="Free VRAM" HorizontalAlignment="Stretch" Click="FreeVram_Click" />
                        <glass:GlassButton Text="Settings" HorizontalAlignment="Stretch" Click="Settings_Click" />
                        </StackPanel>
                    </Grid>
            </glass:GlassSlab>

            <!-- Chat surface -->
            <Grid x:Name="ChatColumn" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: session label, mode toggle, governor pill -->
                <glass:GlassSlab x:Name="HeaderSlab" Grid.Row="0" Margin="0,0,0,8" SlabCornerRadius="14">
                        <Grid Padding="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SessionLabel" Text="Default Workspace" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Margin="0,0,12,0" Padding="10,4" Background="Transparent" BorderThickness="1">
                                <TextBlock x:Name="GovernorPillText" Text="Offline" Foreground="#F43F5E" FontSize="12" />
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <StackPanel Spacing="8" MinWidth="220">
                                            <TextBlock x:Name="GovernorBackendRow" Text="Backend: —" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBlock x:Name="GovernorModelRow" Text="Model: —" FontSize="12" Foreground="#CBD5E1" />
                                            <TextBlock x:Name="GovernorStatusRow" Text="Status: —" FontSize="12" Foreground="#CBD5E1" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <glass:GlassButton x:Name="HudButton" Grid.Column="2" Text="HUD" MinWidth="72" Margin="0,0,8,0" Click="HudButton_Click" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                <!-- Governor on/off and mic on/off are glass switches (popups can't host glass). -->
                                <!-- Ephemeral: an off-the-record scratchpad in either space; nothing is stored. -->
                                <TextBlock x:Name="EphemeralLabel" Text="Ephemeral" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                <glass:GlassToggle x:Name="EphemeralToggle" VerticalAlignment="Center" Toggled="EphemeralToggle_Toggled" />
                                <TextBlock x:Name="GovernorLabel" Text="Governor" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <glass:GlassToggle x:Name="GovernorToggle" IsOn="True" VerticalAlignment="Center" Toggled="GovernorToggle_Toggled" />
                                <TextBlock x:Name="MicLabel" Text="Mic" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <glass:GlassToggle x:Name="MicToggle" VerticalAlignment="Center" Toggled="MicToggle_Toggled" />
                                <TextBlock x:Name="VoiceStateText" Text="" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                <glass:GlassButton x:Name="PanelButton" Text="Panel" MinWidth="80" Click="ToggleRightPanel_Click" />
                            </StackPanel>
                        </Grid>
                </glass:GlassSlab>

                <!-- Message list -->
                <glass:GlassSlab Grid.Row="1" SlabCornerRadius="18">
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <InfoBar
                            x:Name="ErrorBanner"
                            Grid.Row="0"
                            Severity="Error"
                            IsOpen="False"
                            Margin="12,12,12,0"
                            CornerRadius="10" />
                        <ListView
                            x:Name="MessageList"
                            Grid.Row="1"
                            Padding="16"
                            SelectionMode="None"
                            IsSwipeEnabled="False"
                            ItemsSource="{x:Bind ChatViewModel.Messages}">
                            <!-- No theme transitions: the default entrance slid each bubble's XAML
                                 on the compositor while its glass sat still. -->
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <!--
                                    No x:DataType/x:Bind here deliberately: MessageBubbleControl
                                    renders via classic Binding/DataContext (see its code-behind),
                                    since it must re-render markdown on every streamed token
                                    change, not just once at bind time.
                                -->
                                <DataTemplate>
                                    <views:MessageBubbleControl HorizontalAlignment="Stretch" Loaded="MessageBubble_Loaded" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        </Grid>
                </glass:GlassSlab>

                <!-- Composer -->
                <glass:GlassSlab Grid.Row="2" Margin="0,8,0,0" SlabCornerRadius="14">
                        <StackPanel Padding="12" Spacing="6">
                            <ItemsControl x:Name="AttachmentChips">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <!-- Only shown while an image is attached: says whether the model will
                                 actually see it, or have it described by the captioner. -->
                            <TextBlock x:Name="VisionHint" FontSize="11" Opacity="0.7" Visibility="Collapsed" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="📎" FontSize="14" Padding="8,4" Click="AttachFile_Click" />
                                <glass:GlassTextField
                                    x:Name="ComposerBox"
                                    Grid.Column="1"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Placeholder="Message Jarvis..."
                                    AcceptsReturn="True"
                                    InputMaxHeight="160"
                                    InputKeyDown="ComposerBox_KeyDown" />
                                <glass:GlassButton
                                    x:Name="SendButton"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="Send"
                                    IsAccent="True"
                                    Click="SendButton_Click" />
                            </Grid>
                        </StackPanel>
                </glass:GlassSlab>

                <!-- Awareness tray: floats above the composer, bottom-right of the chat column -->
                <ContentControl
                    x:Name="AwarenessTrayHost"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,8,8"
                    IsTabStop="False" />
            </Grid>

            <!-- Right panel: overlay sheet with Artifacts + Files tabs -->
            <glass:GlassSlab
                x:Name="RightPanel"
                Grid.Column="2"
                Margin="8,0,0,0"
                SlabCornerRadius="18"
                Visibility="Collapsed">
                    <!--
                        Tabs are a GlassSegmented (labels rendered inside the glass, the pill
                        refracts them as it slides); the pages below are plain grids switched
                        by SelectedIndex in code-behind.
                    -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="12,12,12,0">
                            <glass:GlassSegmented x:Name="RightPanelTabs" Items="Artifacts|Files|Reasoning|Context|Activity" SelectionChanged="RightPanelTabs_SelectionChanged" />
                            <!-- Reasoning-is-streaming badge, top-right of the tab strip. -->
                            <Ellipse x:Name="ReasoningBadge" Width="6" Height="6" Fill="#06B6D4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid x:Name="ArtifactsPage" Visibility="Visible">
                            <Grid Padding="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button Content="Refresh" HorizontalAlignment="Stretch" Click="RefreshArtifacts_Click" />
                                <ListView
                                    x:Name="ArtifactsList"
                                    Grid.Row="1"
                                    MaxHeight="160"
                                    ItemsSource="{x:Bind RightPanelViewModel.Artifacts}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Artifact">
                                            <Grid Padding="8,6" Tapped="ArtifactItem_Tapped" Tag="{x:Bind}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" Foreground="#CBD5E1" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Type}" Foreground="#64748B" FontSize="10" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
                                    <TextBlock
                                        x:Name="ArtifactContent"
                                        Text="{x:Bind RightPanelViewModel.SelectedContent, Mode=OneWay}"
                                        FontFamily="Cascadia Mono, Consolas, monospace"
                                        FontSize="12"
                                        Foreground="#E2E8F0"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </Grid>
                            </Grid>
                            <Grid x:Name="FilesPage" Visibility="Collapsed">
                            <Grid Padding="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button Content="Refresh" HorizontalAlignment="Stretch" Click="RefreshFiles_Click" />
                                <ListView
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    ItemsSource="{x:Bind RightPanelViewModel.Files}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProjectFile">
                                            <TextBlock Text="{x:Bind Name}" Foreground="#CBD5E1" FontSize="12" Padding="8,4" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                            </Grid>
                            <Grid x:Name="ReasoningPage" Visibility="Collapsed">
                            <ScrollViewer Padding="12">
                                <TextBlock x:Name="ReasoningText" Text="No reasoning for this turn yet."
                                           TextWrapping="Wrap" FontSize="12" Foreground="#94A3B8"
                                           FontFamily="Cascadia Mono, Consolas, monospace" />
                            </ScrollViewer>
                            </Grid>
                            <Grid x:Name="ContextPage" Visibility="Collapsed">
                            <ScrollViewer Padding="12">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="ContextBudgetHeader" Text="No turn yet" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                    <Grid x:Name="ContextBudgetGrid" ColumnSpacing="8" RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="Tier1Text" Text="Tier1 System: —" FontSize="11" Foreground="#94A3B8" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="Tier2Text" Text="Tier2 User+Files: —" FontSize="11" Foreground="#94A3B8" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="Tier3Text" Text="Tier3 RAG: —" FontSize="11" Foreground="#94A3B8" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="Tier4Text" Text="Tier4 History: —" FontSize="11" Foreground="#94A3B8" />
                                    </Grid>
                                    <TextBlock Text="Retrieved Code Chunks" Foreground="#64748B" FontSize="11" Margin="0,8,0,0" />
                                    <ItemsControl x:Name="RetrievedChunksList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            </Grid>
                            <Grid x:Name="ActivityPage" Visibility="Collapsed">
                            <ScrollViewer Padding="12">
                                <ItemsControl x:Name="ActivityStepsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
            </glass:GlassSlab>
        </Grid>

        <!--
            Workspace dropdown: one frosted glass card (iOS search-suggestions style) floated
            under the workspace button; rows are plain text on the card, the active one lit.
            Positioned from code-behind when opened; light-dismissed by any press outside it.
        -->
        <!--
            No XAML fill on the card: the menu's labels are glass text (GlassSegmented), and a
            fill would sit above them. What would otherwise show through the card is the
            sidebar's plain-XAML text (the sessions header and rows): every slab's glass
            renders beneath all XAML, so those are hidden while the card is open instead
            (SetWorkspaceDropdownOpen).
        -->
        <glass:GlassSlab
            x:Name="WorkspaceDropdown"
            Grid.Row="0"
            Grid.RowSpan="2"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            SlabCornerRadius="14"
            TintAmount="0.55"
            Frost="16"
            BezelWidth="8"
            Refraction="5"
            Specular="0.5"
            Shadow="0.4"
            ShadowRadius="24"
            ShadowOffsetY="8"
            Padding="6"
            MinWidth="220">
            <StackPanel Spacing="6">
                <!-- Rows + the sliding puck are the vertical segmented control; Items set from code. -->
                <glass:GlassSegmented x:Name="WorkspaceMenu" Orientation="Vertical" Items="Default Workspace" SelectionChanged="WorkspaceMenu_SelectionChanged" DragPullChanged="WorkspaceMenu_DragPullChanged" />
                <!-- Not a row of the menu: creating is an action, not a selection the puck should land on. -->
                <glass:GlassButton x:Name="NewWorkspaceButton" Text="＋ New workspace" HorizontalAlignment="Stretch" Click="NewWorkspace_Click" />
            </StackPanel>
        </glass:GlassSlab>

        <!--
            Startup card: shown while BackendHost brings uvicorn up; the panels start invisible
            (glass too) and rise into place once state is loaded (MainWindow.Motion.cs). Static
            while waiting (only the caption breathes, in XAML), so the wait costs no GPU.
        -->
        <Grid x:Name="StartupOverlay" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
            <glass:GlassSlab
                x:Name="StartupCard"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                SlabCornerRadius="24"
                TintAmount="0.3"
                Frost="12"
                Padding="44,26">
                <StackPanel Spacing="8">
                    <TextBlock Text="JARVIS" Foreground="#06B6D4" FontSize="24" FontWeight="SemiBold" CharacterSpacing="360" HorizontalAlignment="Center" />
                    <TextBlock x:Name="StartupStatus" Text="Starting up" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </glass:GlassSlab>
        </Grid>

        <!-- Settings sheet overlay (see Views/SettingsPane.xaml); filled on demand by Settings_Click. -->
        <Grid x:Name="SettingsHost" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
