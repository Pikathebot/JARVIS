<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Jarvis_App.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:Jarvis.Core.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Settings"
    PrimaryButtonText="Close"
    DefaultButton="Primary"
    mc:Ignorable="d">

    <ScrollViewer MaxHeight="480">
        <StackPanel Spacing="16" MinWidth="380">

            <StackPanel Spacing="4">
                <TextBlock Text="ACTIVE BACKEND" FontSize="11" Foreground="#64748B" />
                <TextBlock x:Name="BackendText" Text="—" FontSize="14" Foreground="White" />
                <TextBlock x:Name="ModelText" Text="—" FontSize="12" Foreground="#94A3B8" />
            </StackPanel>

            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MODELS" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                    <ProgressRing
                        x:Name="ModelBusyRing"
                        Grid.Column="1"
                        Width="14"
                        Height="14"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>
                <TextBlock
                    Text="Main is what chat runs on; Fast is the smaller model the router falls back to. Models kept directly in models/ are recommended."
                    FontSize="11"
                    Foreground="#64748B"
                    TextWrapping="Wrap" />

                <ListView
                    x:Name="ModelList"
                    SelectionMode="None"
                    MaxHeight="200"
                    ItemsSource="{x:Bind ModelsViewModel.Models}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ModelInfo">
                            <Grid Padding="8,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Name}" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <!-- Visibility set in code-behind: x:Bind cannot express a bool-to-Visibility hop without a converter. -->
                                        <TextBlock
                                            x:Name="RecommendedBadge"
                                            Text="Recommended"
                                            Foreground="#06B6D4"
                                            FontSize="10"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="ModelSubtitle"
                                        Foreground="#64748B"
                                        FontSize="11"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    x:Name="MainButton"
                                    Grid.Column="1"
                                    Content="Main"
                                    Padding="10,2"
                                    FontSize="11"
                                    Tag="{x:Bind}"
                                    Click="SelectMainModel_Click" />
                                <Button
                                    x:Name="FastButton"
                                    Grid.Column="2"
                                    Content="Fast"
                                    Padding="10,2"
                                    FontSize="11"
                                    Tag="{x:Bind}"
                                    Click="SelectFastModel_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="ModelStatusText"
                    FontSize="11"
                    Foreground="#94A3B8"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="PERSONA" FontSize="11" Foreground="#64748B" />
                <ListView
                    x:Name="PersonaList"
                    SelectionMode="None"
                    MaxHeight="140"
                    ItemsSource="{x:Bind PersonaViewModel.Available}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PersonaSummary">
                            <Grid Padding="8,6" Tapped="PersonaItem_Tapped" Tag="{x:Bind}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" Foreground="White" FontSize="13" />
                                    <TextBlock Text="{x:Bind Description}" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="ActiveBadge"
                                    Grid.Column="1"
                                    Text="Active"
                                    Foreground="#06B6D4"
                                    FontSize="10"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Addresses you as" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AddressTermBox" PlaceholderText="sir" />
                    <Button Grid.Column="1" Content="Apply" Margin="8,0,0,0" Click="ApplyAddressTerm_Click" />
                </Grid>
                <HyperlinkButton Content="Reset customizations" Click="ResetOverrides_Click" Padding="0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch x:Name="ProactiveActionsToggle" Header="Proactive actions" Toggled="ProactiveActionsToggle_Toggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="SCHEDULED ROUTINES" FontSize="11" Foreground="#64748B" />
                <ListView
                    x:Name="RoutinesList"
                    SelectionMode="None"
                    MaxHeight="160"
                    ItemsSource="{x:Bind RoutinesViewModel.Routines}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Routine">
                            <Grid Padding="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="White" FontSize="13">
                                        <Run Text="{x:Bind Name}" />
                                        <Run Text=" · " Foreground="#64748B" />
                                        <Run Text="{x:Bind Time}" Foreground="#94A3B8" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Kind}" Foreground="#64748B" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Test" FontSize="11" Padding="8,2" Tag="{x:Bind}" Click="RunRoutine_Click" />
                                <Button Grid.Column="2" Content="Remove" FontSize="11" Padding="8,2" Margin="6,0,0,0" Tag="{x:Bind}" Click="RemoveRoutine_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RoutineNameBox" PlaceholderText="Routine name" />
                    <TimePicker x:Name="RoutineTimePicker" Grid.Column="1" MinuteIncrement="5" />
                    <ComboBox x:Name="RoutineKindCombo" Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="briefing" />
                        <ComboBoxItem Content="message" />
                    </ComboBox>
                </Grid>
                <TextBox x:Name="RoutineMessageBox" PlaceholderText="Message (for 'message' routines)" />
                <Button Content="Add routine" HorizontalAlignment="Stretch" Click="AddRoutine_Click" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="GLASS" FontSize="11" Foreground="#64748B" />
                <TextBlock Text="The liquid-glass panels refract what is actually on your desktop. To do that Jarvis excludes its own windows from screen capture — screen recorders, Zoom/Teams screen-share and Xbox Game Bar will not see it."
                           FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
