<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.NewWorkspacePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:glass="using:Jarvis_Glass"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Same shape as SettingsPane: an in-window glass sheet over a scrim rather than a
        ContentDialog, which is a popup painted above the window where the glass can't reach.
    -->
    <Grid Background="#66000000" Tapped="Scrim_Tapped">
        <glass:GlassSlab x:Name="Sheet" SlabCornerRadius="20" TintAmount="0.62" Frost="36"
                         Width="460" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Background="Transparent" Tapped="Sheet_Tapped">
            <Grid Padding="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <TextBlock Text="New workspace" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <glass:GlassButton Text="✕" Width="34" Height="34" MinWidth="34" MinHeight="34" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" glass:GlassScroll.Immediate="True">
                    <StackPanel Spacing="14" MinWidth="380">

                        <StackPanel Spacing="4">
                            <TextBlock Text="NAME" FontSize="11" Foreground="#64748B" />
                            <TextBox x:Name="NameBox" PlaceholderText="e.g. Thesis, Home automation, jarvis-backend" TextChanged="NameBox_TextChanged" KeyDown="NameBox_KeyDown" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="DESCRIPTION" FontSize="11" Foreground="#64748B" />
                            <TextBox x:Name="DescriptionBox" PlaceholderText="What this workspace is for (optional)" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="INSTRUCTIONS" FontSize="11" Foreground="#64748B" />
                            <TextBox x:Name="InstructionsBox" PlaceholderText="Standing instructions for Jarvis in this workspace (optional)"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="LOCAL FOLDERS" FontSize="11" Foreground="#64748B" />
                            <TextBlock Text="Folders on this PC to index into the workspace's knowledge, alongside anything you attach."
                                       FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                            <ItemsControl x:Name="FoldersList" ItemsSource="{x:Bind Folders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind}" Foreground="White" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Content="Remove" FontSize="11" Padding="8,2" Margin="6,0,0,0" Tag="{x:Bind}" Click="RemoveFolder_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add folder…" HorizontalAlignment="Left" Click="AddFolder_Click" />
                        </StackPanel>

                        <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,14,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="Cancel" Click="Close_Click" />
                    <Button x:Name="CreateButton" Grid.Column="2" Content="Create workspace" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="Create_Click" />
                </Grid>
            </Grid>
        </glass:GlassSlab>
    </Grid>
</UserControl>
