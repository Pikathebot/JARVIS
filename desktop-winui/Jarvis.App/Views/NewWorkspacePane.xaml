<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.NewWorkspacePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:glass="using:Jarvis_Glass"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        An in-window glass sheet over a scrim rather than a
        ContentDialog, which is a popup painted above the window where the glass can't reach.
    -->
    <Grid Background="{ThemeResource ScrimBrush}" Tapped="Scrim_Tapped">
        <glass:GlassSlab x:Name="Sheet" Material="Thick" SlabCornerRadius="{StaticResource RadiusSheet}" TintAmount="0.62" Frost="36"
                         Width="460" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Background="Transparent" Tapped="Sheet_Tapped">
            <Grid Padding="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <TextBlock Text="New workspace" Style="{StaticResource Title2Text}" VerticalAlignment="Center" />
                    <glass:GlassButton Text="✕" Width="36" Height="36" MinWidth="36" MinHeight="36" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" glass:GlassScroll.Immediate="True">
                    <StackPanel Spacing="14" MinWidth="380">

                        <StackPanel Spacing="4">
                            <TextBlock Text="Name" Style="{StaticResource SecondaryFootnoteText}" />
                            <TextBox x:Name="NameBox" PlaceholderText="e.g. Thesis, Home automation, jarvis-backend" TextChanged="NameBox_TextChanged" KeyDown="NameBox_KeyDown" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Description" Style="{StaticResource SecondaryFootnoteText}" />
                            <TextBox x:Name="DescriptionBox" PlaceholderText="What this workspace is for (optional)" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Instructions" Style="{StaticResource SecondaryFootnoteText}" />
                            <TextBox x:Name="InstructionsBox" PlaceholderText="Standing instructions for Jarvis in this workspace (optional)"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Location" Style="{StaticResource SecondaryFootnoteText}" />
                            <TextBlock Text="The folder this workspace is: Jarvis reads, indexes and writes its files there. Leave it to have Jarvis make a new folder for it."
                                       Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LocationText" Text="New folder in Jarvis's workspaces" Style="{StaticResource BodyText}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="Choose folder…" Click="ChooseLocation_Click" />
                                <Button x:Name="ClearLocationButton" Grid.Column="2" Content="Clear" Visibility="Collapsed" Click="ClearLocation_Click" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Extra folders to index" Style="{StaticResource SecondaryFootnoteText}" />
                            <TextBlock Text="Other folders Jarvis searches for answers. It works in the location above, not in these."
                                       Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" />
                            <ItemsControl x:Name="FoldersList" ItemsSource="{x:Bind Folders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind}" Style="{StaticResource BodyText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Content="Remove" Padding="8,2" Margin="8,0,0,0" Tag="{x:Bind}" Click="RemoveFolder_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add folder…" HorizontalAlignment="Left" Click="AddFolder_Click" />
                        </StackPanel>

                        <TextBlock x:Name="ErrorText" Style="{StaticResource FootnoteText}" Foreground="{ThemeResource StatusErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,14,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="Cancel" Click="Close_Click" />
                    <Button x:Name="CreateButton" Grid.Column="2" Content="Create workspace" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="Create_Click" />
                </Grid>
            </Grid>
        </glass:GlassSlab>
    </Grid>
</UserControl>
