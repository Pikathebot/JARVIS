<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.SettingsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:Jarvis.Core.Models"
    xmlns:glass="using:Jarvis_Glass"
    xmlns:vm="using:Jarvis_App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Settings is an in-window sheet, not a ContentDialog: dialogs and flyouts are popups painted
        above the window, where the glass renderer behind it can't reach, so nothing inside them
        could be glass. Here the sheet is a layer-2 slab over the panels and its switches are real
        GlassToggles. The scrim is XAML above the glass (it dims the panels beneath).
    -->
    <Grid Background="{ThemeResource ScrimBrush}" Tapped="Scrim_Tapped">
        <glass:GlassSlab x:Name="Sheet" Material="Thick" SlabCornerRadius="{StaticResource RadiusSheet}" TintAmount="0.62" Frost="36"
                         Width="460" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Background="Transparent" Tapped="Sheet_Tapped">
            <Grid Padding="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="Settings" Style="{StaticResource Title2Text}" VerticalAlignment="Center" />
                    <glass:GlassButton Text="✕" Width="36" Height="36" MinWidth="36" MinHeight="36" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" />
                </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" glass:GlassScroll.Immediate="True">
        <StackPanel Spacing="16" MinWidth="380">

            <!-- Appearance: dark (default), light glass, high contrast. Applied live (JarvisTheme). -->
            <StackPanel Spacing="8">
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderText}" />
                <glass:GlassSegmented x:Name="AppearanceSwitch" Items="Dark|Light|High contrast" HorizontalAlignment="Stretch" SelectionChanged="AppearanceSwitch_SelectionChanged" />
                <TextBlock x:Name="AppearanceNote" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="Windows high contrast is on, so Jarvis stays in high contrast." />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Active backend" Style="{StaticResource SectionHeaderText}" />
                <TextBlock x:Name="BackendText" Text="—" Style="{StaticResource BodyText}" />
                <TextBlock x:Name="ModelText" Text="—" Style="{StaticResource SecondaryFootnoteText}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Models" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center" />
                    <ProgressRing
                        x:Name="ModelBusyRing"
                        Grid.Column="1"
                        Width="14"
                        Height="14"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>
                <TextBlock
                    Text="Main is what chat runs on; Fast is the smaller model the router falls back to. Models kept directly in models/ are recommended."
                    Style="{StaticResource SecondaryFootnoteText}"
                    TextWrapping="Wrap" />

                <ListView
                    x:Name="ModelList"
                    SelectionMode="None"
                    MaxHeight="200"
                    ItemsSource="{x:Bind ModelsViewModel.Models}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ModelInfo">
                            <Grid Padding="8,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                        <!-- Visibility set in code-behind: x:Bind cannot express a bool-to-Visibility hop without a converter. -->
                                        <TextBlock
                                            x:Name="RecommendedBadge"
                                            Text="Recommended"
                                            Style="{StaticResource CaptionEmphasisText}"
                                            Foreground="{ThemeResource AccentTextBrush}"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="ModelSubtitle"
                                        Style="{StaticResource SecondaryFootnoteText}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    x:Name="MainButton"
                                    Grid.Column="1"
                                    Content="Main"
                                    Padding="10,2"
                                    Tag="{x:Bind}"
                                    Click="SelectMainModel_Click" />
                                <Button
                                    x:Name="FastButton"
                                    Grid.Column="2"
                                    Content="Fast"
                                    Padding="10,2"
                                    Tag="{x:Bind}"
                                    Click="SelectFastModel_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="ModelStatusText"
                    Style="{StaticResource SecondaryFootnoteText}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- Get models (PLAN 4.8b): curated list, HuggingFace search, a repo's files, downloads.
                 Every row says per slot whether it fits the card (model_hub.fit_label). -->
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Get models" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center" />
                    <ProgressRing x:Name="HubBusyRing" Grid.Column="1" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="HubBudgetText" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" Visibility="Collapsed" />

                <TextBlock Text="Known to work here" Style="{StaticResource BodyText}" />
                <ListView x:Name="CuratedList" SelectionMode="None" MaxHeight="240" ItemsSource="{x:Bind ModelsViewModel.Hub.Curated}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CuratedModel">
                            <Grid Padding="8,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind File.Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind FitDisplay}" Style="{StaticResource FootnoteText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{x:Bind DownloadLabel}" IsEnabled="{x:Bind CanDownload}" Padding="10,2"
                                        VerticalAlignment="Center" Tag="{x:Bind}" Click="DownloadCurated_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HubSearchBox" PlaceholderText="Search HuggingFace for GGUF models" KeyDown="HubSearchBox_KeyDown" />
                    <Button Grid.Column="1" Content="Search" Click="HubSearch_Click" />
                </Grid>
                <ListView x:Name="HubResultsList" SelectionMode="None" MaxHeight="200" ItemsSource="{x:Bind ModelsViewModel.Hub.SearchResults}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:HubSearchResult">
                            <Grid Padding="8,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Repo}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryFootnoteText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Files" Padding="10,2" VerticalAlignment="Center" Tag="{x:Bind}" Click="OpenRepo_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- A repo's files: shown after "Files" on a search result. -->
                <StackPanel x:Name="RepoPanel" Spacing="6" Visibility="Collapsed">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RepoTitle" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Close" Padding="10,2" Click="CloseRepo_Click" />
                    </Grid>
                    <StackPanel x:Name="RepoVisionRow" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Download vision (projector) too" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <glass:GlassToggle x:Name="RepoVisionToggle" VerticalAlignment="Center" Toggled="RepoVisionToggle_Toggled" />
                    </StackPanel>
                    <ListView x:Name="RepoFilesList" SelectionMode="None" MaxHeight="280" ItemsSource="{x:Bind ModelsViewModel.Hub.RepoFiles}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:HubFileInfo">
                                <Grid Padding="8,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind SizeDisplay}" Style="{StaticResource SecondaryFootnoteText}" />
                                        <TextBlock Text="{x:Bind FitDisplay}" Style="{StaticResource FootnoteText}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{x:Bind DownloadLabel}" IsEnabled="{x:Bind CanDownload}" Padding="10,2"
                                            VerticalAlignment="Center" Tag="{x:Bind}" Click="DownloadRepoFile_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <ListView x:Name="DownloadsList" SelectionMode="None" MaxHeight="200" ItemsSource="{x:Bind ModelsViewModel.Hub.Downloads}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DownloadItem">
                            <Grid Padding="8,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Cancel" Padding="10,2" VerticalAlignment="Center"
                                        IsEnabled="{x:Bind CanCancel, Mode=OneWay}" Tag="{x:Bind}" Click="CancelDownload_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="HubStatusText" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Persona" Style="{StaticResource SectionHeaderText}" />
                <ListView
                    x:Name="PersonaList"
                    SelectionMode="None"
                    MaxHeight="140"
                    ItemsSource="{x:Bind PersonaViewModel.Available}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PersonaSummary">
                            <Grid Padding="8,6" Tapped="PersonaItem_Tapped" Tag="{x:Bind}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyText}" />
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="ActiveBadge"
                                    Grid.Column="1"
                                    Text="Active"
                                    Style="{StaticResource CaptionEmphasisText}"
                                    Foreground="{ThemeResource AccentTextBrush}"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="Addresses you as" Style="{StaticResource SecondaryFootnoteText}" Margin="0,4,0,0" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AddressTermBox" PlaceholderText="sir" />
                    <Button Grid.Column="1" Content="Apply" Margin="8,0,0,0" Click="ApplyAddressTerm_Click" />
                </Grid>
                <HyperlinkButton Content="Reset customizations" Click="ResetOverrides_Click" Padding="0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Proactive actions" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <glass:GlassToggle x:Name="ProactiveActionsToggle" VerticalAlignment="Center" Toggled="ProactiveActionsToggle_Toggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Scheduled routines" Style="{StaticResource SectionHeaderText}" />
                <ListView
                    x:Name="RoutinesList"
                    SelectionMode="None"
                    MaxHeight="160"
                    ItemsSource="{x:Bind RoutinesViewModel.Routines}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Routine">
                            <Grid Padding="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyText}">
                                        <Run Text="{x:Bind Name}" />
                                        <Run Text=" · " Foreground="{ThemeResource LabelSecondaryBrush}" />
                                        <Run Text="{x:Bind Time}" Foreground="{ThemeResource LabelSecondaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Kind}" Style="{StaticResource SecondaryFootnoteText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Test" Padding="8,2" Tag="{x:Bind}" Click="RunRoutine_Click" />
                                <Button Grid.Column="2" Content="Remove" Padding="8,2" Margin="8,0,0,0" Tag="{x:Bind}" Click="RemoveRoutine_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RoutineNameBox" PlaceholderText="Routine name" />
                    <TimePicker x:Name="RoutineTimePicker" Grid.Column="1" MinuteIncrement="5" />
                    <ComboBox x:Name="RoutineKindCombo" Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="briefing" />
                        <ComboBoxItem Content="message" />
                    </ComboBox>
                </Grid>
                <TextBox x:Name="RoutineMessageBox" PlaceholderText="Message (for 'message' routines)" />
                <Button Content="Add routine" HorizontalAlignment="Stretch" Click="AddRoutine_Click" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Glass" Style="{StaticResource SectionHeaderText}" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource StatusWarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Text="The liquid-glass panels refract what is actually on your desktop. To do that Jarvis excludes its own windows from screen capture — screen recorders, Zoom/Teams screen-share and Xbox Game Bar will not see it."
                               Style="{StaticResource FootnoteText}" Foreground="{ThemeResource StatusWarningBrush}" TextWrapping="Wrap" MaxWidth="360" />
                </StackPanel>
            </StackPanel>

            <!-- Developer (PLAN 4.8d): live glass material tuning, one group at a time so only a
                 handful of glass sliders are live. Rows are built in code-behind from GlassTuning. -->
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Developer" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center" />
                    <glass:GlassToggle x:Name="DeveloperToggle" Grid.Column="1" VerticalAlignment="Center" Toggled="DeveloperToggle_Toggled" />
                </Grid>
                <StackPanel x:Name="TuningPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="Glass material, live. Your changes are kept across restarts; Copy values puts them on the clipboard as code to bake in."
                               Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" />
                    <glass:GlassSegmented x:Name="TuningGroups" Items="Lens|Toggle|Slider|Button|Field|Panels" HorizontalAlignment="Stretch"
                                          SelectionChanged="TuningGroups_SelectionChanged" />
                    <StackPanel x:Name="TuningRows" Spacing="4" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Reset group" HorizontalAlignment="Stretch" Click="ResetTuningGroup_Click" />
                        <Button Grid.Column="1" Content="Reset all" HorizontalAlignment="Stretch" Click="ResetTuningAll_Click" />
                        <Button Grid.Column="2" Content="Copy values" HorizontalAlignment="Stretch" Click="CopyTuning_Click" />
                    </Grid>
                    <TextBlock x:Name="TuningStatus" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
            </Grid>
        </glass:GlassSlab>
    </Grid>
</UserControl>
