<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.ThinkingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- One stretch of the model's thinking (PLAN 4.23, design system "Thinking"): a quiet line,
         "Checking the calendar for Friday" while it thinks and "Thought for 6 s" after, that opens
         to the full text under a hairline rule. No fill: it reads as a margin note, not a step. -->
    <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="4" Margin="0,0,0,2">
        <Button x:Name="Row" HorizontalAlignment="Left" Padding="0,3" BorderThickness="0"
                Background="Transparent" Click="Row_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="Icon" Style="{StaticResource JarvisIcon}" Glyph="&#xE82F;" FontSize="12"
                          Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="Label" Style="{StaticResource SecondaryFootnoteText}" TextTrimming="CharacterEllipsis"
                           MaxWidth="480" VerticalAlignment="Center" />
                <FontIcon x:Name="Chevron" Style="{StaticResource JarvisIcon}" Glyph="&#xE76C;" FontSize="10"
                          Foreground="{ThemeResource LabelTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Border x:Name="Detail" Visibility="Collapsed" Margin="5,0,0,4" Padding="12,2,0,2"
                BorderThickness="2,0,0,0" BorderBrush="{ThemeResource SeparatorBrush}">
            <TextBlock x:Name="DetailText" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap"
                       IsTextSelectionEnabled="True" />
        </Border>
    </StackPanel>
</UserControl>
