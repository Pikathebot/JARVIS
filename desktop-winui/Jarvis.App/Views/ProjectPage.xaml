<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.ProjectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:glass="using:Jarvis_Glass">

    <!--
        A workspace's own page (design system: ProjectPage; PLAN 4.18). It replaces the transcript in
        the chat area, on the same thick slab, so the first 40 px stay clear for the toolbar capsules
        (the slab's padding already does that). Slice 1: header + Instructions. Project state,
        Memories, Files and Chats follow in later slices.
    -->
    <UserControl.Resources>
        <Style x:Key="PageCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource FillTertiaryBrush}" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel MaxWidth="720" Margin="24,16,24,32" Spacing="24" HorizontalAlignment="Stretch">

            <!-- Header: name, folder, index line -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="NameText" Style="{StaticResource Title2Text}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="FolderText" Style="{StaticResource DataText}"
                               Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="520" />
                    <HyperlinkButton x:Name="OpenFolderLink" Content="Open folder" Padding="4,0" Click="OpenFolder_Click" />
                </StackPanel>
                <Grid ColumnSpacing="8" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="IndexText" Style="{StaticResource FootnoteText}" Foreground="{ThemeResource LabelSecondaryBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                    <glass:GlassButton x:Name="ReindexButton" Grid.Column="1" Text="Reindex" Click="Reindex_Click" />
                </Grid>
            </StackPanel>

            <!-- Instructions -->
            <StackPanel Spacing="6">
                <Grid>
                    <TextBlock Text="Instructions" Style="{StaticResource SectionHeaderText}" Margin="4,0,0,0" />
                    <HyperlinkButton x:Name="EditInstructionsLink" Content="Edit" Padding="4,0" HorizontalAlignment="Right" Click="EditInstructions_Click" />
                </Grid>
                <Border Style="{StaticResource PageCard}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="InstructionsText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" MaxLines="6" TextTrimming="CharacterEllipsis" />
                        <TextBox x:Name="InstructionsBox" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="120" MaxHeight="320" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PlaceholderText="Rules Jarvis should follow in every chat here (Enter saves, Shift+Enter adds a line)"
                                 KeyDown="InstructionsBox_KeyDown" />
                        <StackPanel x:Name="InstructionsButtons" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Visibility="Collapsed">
                            <glass:GlassButton Text="Cancel" Click="CancelInstructions_Click" />
                            <glass:GlassButton x:Name="SaveInstructionsButton" Text="Save" IsAccent="True" Click="SaveInstructions_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="InstructionsNote" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" Margin="4,0,0,0"
                           Text="Sent to the model at the start of every chat in this project. A change reaches Jarvis from your next chat." />
            </StackPanel>

            <!-- Project state: .jarvis/PROJECT.md, rendered; Edit shows the raw Markdown -->
            <StackPanel Spacing="6">
                <Grid>
                    <TextBlock Text="Project state" Style="{StaticResource SectionHeaderText}" Margin="4,0,0,0" />
                    <HyperlinkButton x:Name="EditStateLink" Content="Edit" Padding="4,0" HorizontalAlignment="Right" Click="EditState_Click" />
                </Grid>
                <Border Style="{StaticResource PageCard}">
                    <StackPanel Spacing="10">
                        <ContentPresenter x:Name="StateView" />
                        <TextBox x:Name="StateBox" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono, Consolas" MinHeight="240" MaxHeight="480"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="StateBox_TextChanged" />
                        <Grid x:Name="StateButtons" Visibility="Collapsed" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StateCount" Style="{StaticResource FootnoteText}" VerticalAlignment="Center" />
                            <glass:GlassButton Grid.Column="1" Text="Cancel" Click="CancelState_Click" />
                            <glass:GlassButton x:Name="SaveStateButton" Grid.Column="2" Text="Save" IsAccent="True" Click="SaveState_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StateNote" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" Margin="4,0,0,0"
                           Text="Jarvis keeps this current as work lands. You can edit it here or in any editor. A change reaches Jarvis from your next chat." />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
