<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.MessageBubbleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:glass="using:Jarvis_Glass"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    mc:Ignorable="d">

    <Grid Margin="0,4,0,4">
        <!-- System message: centered pill -->
        <Border
            x:Name="SystemPill"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            Background="#1A94A3B8"
            CornerRadius="12"
            Padding="12,4">
            <TextBlock x:Name="SystemText" Foreground="#94A3B8" FontSize="12" />
        </Border>

        <!--
            User message: right-aligned accent glass bubble. Bubbles are GlassSlabs nested in the
            chat panel's slab, so they auto-publish one layer above it, clipped to the list's
            viewport; XAML here draws only the text.
        -->
        <StackPanel x:Name="UserRow" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <glass:GlassSlab
                SlabCornerRadius="16"
                TintColor="#0891B2"
                TintAmount="0.42"
                Frost="8"
                BezelWidth="6"
                Refraction="4"
                Specular="0.45"
                Shadow="0.22"
                ShadowRadius="14"
                ShadowOffsetY="4"
                Padding="14,10"
                MaxWidth="640">
                <glass:GlassSlab.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Copy message" Click="CopyMessage_Click" />
                    </MenuFlyout>
                </glass:GlassSlab.ContextFlyout>
                <TextBlock x:Name="UserText" Foreground="White" FontSize="14" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </glass:GlassSlab>
            <Border Width="28" Height="28" CornerRadius="14" Background="#334155" VerticalAlignment="Top">
                <TextBlock Text="U" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </StackPanel>

        <!-- Assistant message: left-aligned glass bubble -->
        <StackPanel x:Name="AssistantRow" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
            <Border Width="28" Height="28" CornerRadius="14" Background="#0891B2" VerticalAlignment="Top">
                <TextBlock Text="J" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel MaxWidth="720" Spacing="6">
                <glass:GlassSlab
                    SlabCornerRadius="16"
                    TintAmount="0.3"
                    Frost="6"
                    BezelWidth="6"
                    Refraction="4"
                    Specular="0.45"
                    Shadow="0.22"
                    ShadowRadius="14"
                    ShadowOffsetY="4"
                    Padding="14,10">
                    <glass:GlassSlab.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Copy message" Click="CopyMessage_Click" />
                        </MenuFlyout>
                    </glass:GlassSlab.ContextFlyout>
                    <StackPanel Spacing="8">
                        <!-- Tool step cards -->
                        <ItemsControl x:Name="ToolStepsHost" />

                        <!-- Rendered markdown content goes here via code-behind -->
                        <ContentPresenter x:Name="ContentHost" />

                        <!-- Streaming caret -->
                        <TextBlock x:Name="StreamingCaret" Text="▍" Foreground="#06B6D4" Visibility="Collapsed" />

                        <!-- Pending confirmation banner -->
                        <Border
                            x:Name="ConfirmationBanner"
                            Visibility="Collapsed"
                            Background="#1AFBBF24"
                            BorderBrush="#FBBF24"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="ConfirmationTitle" Foreground="#FBBF24" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock x:Name="ConfirmationReason" Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock x:Name="ConfirmationArgs" Foreground="#94A3B8" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button x:Name="ApproveButton" Content="Approve Execution" Background="#0891B2" Foreground="White" Click="ApproveButton_Click" />
                                    <Button x:Name="DenyButton" Content="Deny" Click="DenyButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </glass:GlassSlab>

                <!-- Metadata footer -->
                <TextBlock x:Name="MetadataFooter" Foreground="#64748B" FontSize="10" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
