<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.MessageBubbleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    mc:Ignorable="d">

    <Grid>
        <!-- System message: centered pill -->
        <Border
            x:Name="SystemPill"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            Background="{ThemeResource FillTertiaryBrush}"
            CornerRadius="{StaticResource PillCornerRadius}"
            Padding="12,4">
            <TextBlock x:Name="SystemText" Style="{StaticResource SecondaryFootnoteText}" />
        </Border>

        <!--
            User message: a right-aligned accent bubble. Plain XAML on the reading surface,
            not glass: nothing on the surface is glass but the composer.
        -->
        <Border
            x:Name="UserRow"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            MaxWidth="520"
            Margin="0,8,0,8"
            Padding="14,8"
            CornerRadius="18"
            Background="{ThemeResource AccentFillBrush}">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copy message" Click="CopyMessage_Click" />
                </MenuFlyout>
            </Border.ContextFlyout>
            <TextBlock x:Name="UserText" Style="{StaticResource MessageText}" Foreground="{ThemeResource OnAccentBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </Border>

        <!-- Assistant message: no bubble, just text beside the mark, as long answers read best. -->
        <Grid x:Name="AssistantRow" Visibility="Collapsed" ColumnSpacing="12" Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copy message" Click="CopyMessage_Click" />
                </MenuFlyout>
            </Grid.ContextFlyout>
            <!-- Jarvis's avatar is the mark. -->
            <Image Source="{ThemeResource MarkSource}" Width="24" Height="24" VerticalAlignment="Top" Margin="0,1,0,0" />
            <StackPanel Grid.Column="1" Spacing="8">
                        <!-- Tool steps: one line each, open for detail -->
                        <ItemsControl x:Name="ToolStepsHost" />

                        <!-- Rendered markdown content goes here via code-behind -->
                        <ContentPresenter x:Name="ContentHost" />

                        <!-- Streaming caret -->
                        <TextBlock x:Name="StreamingCaret" Text="▍" Foreground="{ThemeResource AccentBrush}" Visibility="Collapsed" />

                        <!-- Pending confirmation banner -->
                        <Border
                            x:Name="ConfirmationBanner"
                            Visibility="Collapsed"
                            MaxWidth="560"
                            HorizontalAlignment="Left"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="12">
                            <Border.Background>
                                <SolidColorBrush Color="{ThemeResource StatusWarningColor}" Opacity="0.14" />
                            </Border.Background>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE7BA;" Foreground="{ThemeResource StatusWarningBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ConfirmationTitle" Style="{StaticResource HeadlineText}" Foreground="{ThemeResource StatusWarningBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="ConfirmationReason" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ConfirmationArgs" Style="{StaticResource CodeInlineText}" Foreground="{ThemeResource AccentTextBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button x:Name="ApproveButton" Content="Approve" Style="{StaticResource AccentButtonStyle}" Click="ApproveButton_Click" />
                                    <Button x:Name="DenyButton" Content="Deny" Click="DenyButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                <!-- Metadata footer -->
                <TextBlock x:Name="MetadataFooter" Style="{StaticResource DataText}" Foreground="{ThemeResource LabelTertiaryBrush}" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
