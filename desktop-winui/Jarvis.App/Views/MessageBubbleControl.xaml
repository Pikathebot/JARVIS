<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.MessageBubbleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    mc:Ignorable="d">

    <Grid>
        <!-- System message: centered pill -->
        <Border
            x:Name="SystemPill"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            Background="{ThemeResource FillTertiaryBrush}"
            CornerRadius="{StaticResource PillCornerRadius}"
            Padding="12,4">
            <TextBlock x:Name="SystemText" Style="{StaticResource SecondaryFootnoteText}" />
        </Border>

        <!--
            Freeform thread marks (PLAN 4.18, design system "Thread"): a day divider (centred
            footnote between hairlines), an episode marker (centred footnote) and a digest card
            (a ToolStepRow-style line that opens to what Jarvis carried over).
        -->
        <Grid x:Name="DayDivider" Visibility="Collapsed" ColumnSpacing="12" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Height="1" VerticalAlignment="Center" Fill="{ThemeResource SeparatorBrush}" />
            <TextBlock x:Name="DayText" Grid.Column="1" Style="{StaticResource SecondaryFootnoteText}" />
            <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{ThemeResource SeparatorBrush}" />
        </Grid>

        <TextBlock
            x:Name="EpisodeMarker"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            Margin="0,8,0,4"
            Style="{StaticResource SecondaryFootnoteText}"
            TextWrapping="Wrap"
            TextAlignment="Center" />

        <StackPanel x:Name="DigestCard" Visibility="Collapsed" Margin="36,0,0,8" Spacing="4" HorizontalAlignment="Left" MaxWidth="560">
            <Button
                x:Name="DigestToggle"
                Click="DigestToggle_Click"
                Height="30"
                Padding="10,0"
                HorizontalAlignment="Left"
                CornerRadius="{StaticResource RowCornerRadius}"
                Background="{ThemeResource FillTertiaryBrush}"
                BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE946;" Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DigestTitle" Style="{StaticResource SecondaryFootnoteText}" VerticalAlignment="Center" />
                    <FontIcon x:Name="DigestChevron" Style="{StaticResource JarvisIcon}" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource LabelTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock
                x:Name="DigestDetail"
                Visibility="Collapsed"
                Margin="10,2,0,0"
                Style="{StaticResource SecondaryFootnoteText}"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True" />
        </StackPanel>

        <!--
            "Conversation compacted" (PLAN 4.25, design system "Thread"): a day-divider-style line
            whose label opens the summary the model goes on from, rendered as markdown on a card.
        -->
        <StackPanel x:Name="CompactedCard" Visibility="Collapsed" Margin="0,16,0,8" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Height="1" VerticalAlignment="Center" Fill="{ThemeResource SeparatorBrush}" />
                <Button x:Name="CompactedToggle" Grid.Column="1" Click="CompactedToggle_Click" Padding="8,3"
                        Background="Transparent" BorderThickness="0" CornerRadius="{StaticResource RowCornerRadius}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE81C;" FontSize="12" Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactedTitle" Style="{StaticResource SecondaryFootnoteText}" VerticalAlignment="Center" />
                        <FontIcon x:Name="CompactedChevron" Style="{StaticResource JarvisIcon}" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource LabelTertiaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Fill="{ThemeResource SeparatorBrush}" />
            </Grid>
            <Border x:Name="CompactedDetail" Visibility="Collapsed" MaxWidth="640" HorizontalAlignment="Center"
                    CornerRadius="{StaticResource CardCornerRadius}" Background="{ThemeResource FillTertiaryBrush}" Padding="16,12">
                <ContentPresenter x:Name="CompactedHost" />
            </Border>
        </StackPanel>

        <!--
            User message: a right-aligned accent bubble. Plain XAML on the reading surface,
            not glass: nothing on the surface is glass but the composer.
        -->
        <Border
            x:Name="UserRow"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            MaxWidth="520"
            Margin="0,8,0,8"
            Padding="14,8"
            CornerRadius="18"
            Background="{ThemeResource AccentFillBrush}">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copy message" Click="CopyMessage_Click" />
                </MenuFlyout>
            </Border.ContextFlyout>
            <StackPanel Spacing="8">
                <StackPanel x:Name="UserImages" Spacing="6" Visibility="Collapsed" />
                <TextBlock x:Name="UserText" Style="{StaticResource MessageText}" Foreground="{ThemeResource OnAccentBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
        </Border>

        <!-- Assistant message: no bubble, just text beside the mark, as long answers read best. -->
        <Grid x:Name="AssistantRow" Visibility="Collapsed" ColumnSpacing="12" Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Copy message" Click="CopyMessage_Click" />
                </MenuFlyout>
            </Grid.ContextFlyout>
            <!-- Jarvis's avatar is the mark. -->
            <Image Source="{ThemeResource MarkSource}" Width="24" Height="24" VerticalAlignment="Top" Margin="0,1,0,0" />
            <StackPanel Grid.Column="1" Spacing="8">
                        <!-- Tool steps: one line each, open for detail -->
                        <ItemsControl x:Name="ToolStepsHost" />

                        <!-- Rendered markdown content goes here via code-behind -->
                        <ContentPresenter x:Name="ContentHost" />

                        <!-- Streaming caret -->
                        <TextBlock x:Name="StreamingCaret" Text="▍" Foreground="{ThemeResource AccentBrush}" Visibility="Collapsed" />

                        <!-- Pending confirmation banner -->
                        <Border
                            x:Name="ConfirmationBanner"
                            Visibility="Collapsed"
                            MaxWidth="560"
                            HorizontalAlignment="Left"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="12">
                            <Border.Background>
                                <SolidColorBrush Color="{ThemeResource StatusWarningColor}" Opacity="0.14" />
                            </Border.Background>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE7BA;" Foreground="{ThemeResource StatusWarningBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ConfirmationTitle" Style="{StaticResource HeadlineText}" Foreground="{ThemeResource StatusWarningBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="ConfirmationReason" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ConfirmationArgs" Style="{StaticResource CodeInlineText}" Foreground="{ThemeResource AccentTextBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button x:Name="ApproveButton" Content="Approve" Style="{StaticResource AccentButtonStyle}" Click="ApproveButton_Click" />
                                    <Button x:Name="DenyButton" Content="Deny" Click="DenyButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- In-app compare (PLAN 4.13 #8): a second take, shown once it is ready -->
                        <Border
                            x:Name="CompareCard"
                            Visibility="Collapsed"
                            MaxWidth="640"
                            HorizontalAlignment="Left"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="12">
                            <Border.Background>
                                <SolidColorBrush Color="{ThemeResource AccentColor}" Opacity="0.10" />
                            </Border.Background>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="CompareTitle" Style="{StaticResource HeadlineText}" TextWrapping="Wrap" />
                                <ContentPresenter x:Name="CompareHost" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button Content="Original" Tag="original" Click="CompareVote_Click" />
                                    <Button Content="This one" Tag="alternative" Style="{StaticResource AccentButtonStyle}" Click="CompareVote_Click" />
                                    <Button Content="Same" Tag="tie" Click="CompareVote_Click" />
                                    <Button Content="Dismiss" Tag="dismiss" Click="CompareVote_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                <!-- Metadata footer -->
                <TextBlock x:Name="MetadataFooter" Style="{StaticResource DataText}" Foreground="{ThemeResource LabelTertiaryBrush}" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
