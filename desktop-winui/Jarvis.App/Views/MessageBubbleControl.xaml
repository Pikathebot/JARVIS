<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.MessageBubbleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:glass="using:Jarvis_Glass"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    mc:Ignorable="d">

    <Grid Margin="0,4,0,4">
        <!-- System message: centered pill -->
        <Border
            x:Name="SystemPill"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            Background="{ThemeResource FillTertiaryBrush}"
            CornerRadius="{StaticResource PillCornerRadius}"
            Padding="12,4">
            <TextBlock x:Name="SystemText" Style="{StaticResource SecondaryFootnoteText}" />
        </Border>

        <!--
            User message: right-aligned accent glass bubble. Bubbles are GlassSlabs nested in the
            chat panel's slab, so they auto-publish one layer above it, clipped to the list's
            viewport; XAML here draws only the text.
        -->
        <StackPanel x:Name="UserRow" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <glass:GlassSlab
                Material="Accent"
                SlabCornerRadius="{StaticResource RadiusPanel}"
                Frost="8"
                BezelWidth="6"
                Refraction="4"
                Specular="0.45"
                Shadow="0.22"
                ShadowRadius="14"
                ShadowOffsetY="4"
                Padding="12,8"
                MaxWidth="640">
                <glass:GlassSlab.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Copy message" Click="CopyMessage_Click" />
                    </MenuFlyout>
                </glass:GlassSlab.ContextFlyout>
                <TextBlock x:Name="UserText" Style="{StaticResource MessageText}" Foreground="{ThemeResource OnAccentBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </glass:GlassSlab>
            <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource SurfaceAvatarBrush}" VerticalAlignment="Top">
                <TextBlock Text="U" Style="{StaticResource FootnoteText}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </StackPanel>

        <!-- Assistant message: left-aligned glass bubble -->
        <StackPanel x:Name="AssistantRow" Visibility="Collapsed" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
            <!-- Jarvis's avatar is the mark. -->
            <Image Source="{ThemeResource MarkSource}" Width="28" Height="28" VerticalAlignment="Top" />
            <StackPanel MaxWidth="720" Spacing="6">
                <glass:GlassSlab
                    SlabCornerRadius="{StaticResource RadiusPanel}"
                    TintAmount="0.3"
                    Frost="6"
                    BezelWidth="6"
                    Refraction="4"
                    Specular="0.45"
                    Shadow="0.22"
                    ShadowRadius="14"
                    ShadowOffsetY="4"
                    Padding="12,8">
                    <glass:GlassSlab.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Copy message" Click="CopyMessage_Click" />
                        </MenuFlyout>
                    </glass:GlassSlab.ContextFlyout>
                    <StackPanel Spacing="8">
                        <!-- Tool step cards -->
                        <ItemsControl x:Name="ToolStepsHost" />

                        <!-- Rendered markdown content goes here via code-behind -->
                        <ContentPresenter x:Name="ContentHost" />

                        <!-- Streaming caret -->
                        <TextBlock x:Name="StreamingCaret" Text="▍" Foreground="{ThemeResource AccentBrush}" Visibility="Collapsed" />

                        <!-- Pending confirmation banner -->
                        <Border
                            x:Name="ConfirmationBanner"
                            Visibility="Collapsed"
                            CornerRadius="{StaticResource RowCornerRadius}"
                            Padding="12">
                            <Border.Background>
                                <SolidColorBrush Color="{ThemeResource StatusWarningColor}" Opacity="0.14" />
                            </Border.Background>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE7BA;" Foreground="{ThemeResource StatusWarningBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ConfirmationTitle" Style="{StaticResource HeadlineText}" Foreground="{ThemeResource StatusWarningBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="ConfirmationReason" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ConfirmationArgs" Style="{StaticResource CodeInlineText}" Foreground="{ThemeResource AccentTextBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button x:Name="ApproveButton" Content="Approve" Style="{StaticResource AccentButtonStyle}" Click="ApproveButton_Click" />
                                    <Button x:Name="DenyButton" Content="Deny" Click="DenyButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </glass:GlassSlab>

                <!-- Metadata footer -->
                <TextBlock x:Name="MetadataFooter" Style="{StaticResource DataText}" Margin="4,0,0,0" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
