<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.ToolStepCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Expander x:Name="Root" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0">
        <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE90F;" Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ToolName" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <!-- Status badge: icon, word and colour (the fill is the colour at 14%); set in code. -->
                <Border x:Name="StatusBadge" CornerRadius="{StaticResource PillCornerRadius}" Padding="6,2,8,2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon x:Name="StatusIcon" Style="{StaticResource JarvisIcon}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionEmphasisText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="6" Padding="4">
            <TextBlock Text="Arguments" Style="{StaticResource SecondaryFootnoteText}" />
            <TextBlock x:Name="ArgsText" Style="{StaticResource DataText}" TextWrapping="Wrap" />
            <TextBlock x:Name="ResultLabel" Text="Result" Style="{StaticResource SecondaryFootnoteText}" />
            <TextBlock x:Name="ResultText" Style="{StaticResource DataText}" TextWrapping="Wrap" />
        </StackPanel>
    </Expander>
</UserControl>
