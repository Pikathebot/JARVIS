<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.ToolStepCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- One line per tool call: status icon, the tool, the status word, a chevron. Tapping it
         opens the arguments and result underneath. -->
    <StackPanel MaxWidth="480" HorizontalAlignment="Left" Spacing="4" Margin="0,0,0,2">
        <Button x:Name="Row" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Height="30" Padding="10,0" CornerRadius="{StaticResource RowCornerRadius}" BorderThickness="0"
                Background="{ThemeResource FillTertiaryBrush}" Click="Row_Click">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="StatusIcon" Style="{StaticResource JarvisIcon}" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="ToolName" Grid.Column="1" Style="{StaticResource FootnoteText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="2" Style="{StaticResource FootnoteText}" VerticalAlignment="Center" />
                <FontIcon x:Name="Chevron" Grid.Column="3" Style="{StaticResource JarvisIcon}" Glyph="&#xE76C;" FontSize="10"
                          Foreground="{ThemeResource LabelSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Button>
        <!-- look_at_screen: the screenshot itself, open in the default viewer on click. -->
        <Button x:Name="ShotButton" Visibility="Collapsed" Padding="0" BorderThickness="0" Background="Transparent"
                HorizontalAlignment="Left" CornerRadius="{StaticResource RowCornerRadius}" Click="Shot_Click">
            <Image x:Name="ShotImage" MaxHeight="180" MaxWidth="320" Stretch="Uniform" />
        </Button>
        <StackPanel x:Name="Detail" Visibility="Collapsed" Spacing="6" Padding="10,4,10,6">
            <TextBlock Text="Arguments" Style="{StaticResource SecondaryFootnoteText}" />
            <TextBlock x:Name="ArgsText" Style="{StaticResource DataText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="ResultLabel" Text="Result" Style="{StaticResource SecondaryFootnoteText}" />
            <TextBlock x:Name="ResultText" Style="{StaticResource DataText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
