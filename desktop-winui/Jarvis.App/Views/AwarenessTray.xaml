<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.AwarenessTray"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Jarvis.Core.Models"
    xmlns:local="using:Jarvis_App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Port of AwarenessTray.tsx: bottom-right stack of dismissible severity-coded cards.
         Each card is an icon, a title and a detail; the colour repeats what the icon says. -->
    <UserControl.Resources>
        <local:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <local:SeverityToBackgroundConverter x:Key="SeverityToBackground" />
        <local:SeverityToGlyphConverter x:Key="SeverityToGlyph" />
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="8" Width="320">
        <TextBlock
            x:Name="DismissAllLink"
            Text=""
            Style="{StaticResource SecondaryFootnoteText}"
            HorizontalAlignment="Right"
            Tapped="DismissAll_Tapped" />
        <ItemsControl x:Name="ObservationsList" ItemsSource="{x:Bind ViewModel.Observations, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:Observation">
                    <Border
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="12,10"
                        BorderBrush="{x:Bind Severity, Converter={StaticResource SeverityToBrush}}"
                        Background="{x:Bind Severity, Converter={StaticResource SeverityToBackground}}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Style="{StaticResource JarvisIcon}"
                                Margin="0,2,0,0"
                                VerticalAlignment="Top"
                                Glyph="{x:Bind Severity, Converter={StaticResource SeverityToGlyph}}"
                                Foreground="{x:Bind Severity, Converter={StaticResource SeverityToBrush}}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource HeadlineText}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SecondaryFootnoteText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Padding="4"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Dismiss"
                                Tag="{x:Bind}"
                                Click="DismissObservation_Click">
                                <FontIcon Style="{StaticResource JarvisIcon}" Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource LabelSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
