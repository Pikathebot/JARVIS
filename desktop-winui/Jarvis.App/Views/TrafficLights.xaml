<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jarvis_App.Views.TrafficLights"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The traffic-light window buttons, as a control (the main window has its own copy in
         MainWindow.xaml / MainWindow.WindowControls.cs). Windows does the work: each dot's cell is
         registered as the window's Minimize / Maximize / Close non-client region. -->
    <StackPanel Orientation="Horizontal">
        <Grid x:Name="MinimizeHit" Width="23" Height="28" Background="Transparent" AutomationProperties.Name="Minimize">
            <Ellipse x:Name="MinimizeDot" Width="14" Height="14" StrokeThickness="0" />
            <Ellipse x:Name="MinimizePress" Width="14" Height="14" Fill="Black" Opacity="0" IsHitTestVisible="False" />
            <Viewbox x:Name="MinimizeGlyph" Width="14" Height="14" Opacity="0" IsHitTestVisible="False">
                <Canvas Width="12" Height="12">
                    <Path Data="M3.3,6 L8.7,6" Stroke="{ThemeResource WindowControlGlyphBrush}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>
        </Grid>
        <Grid x:Name="MaximizeHit" Width="23" Height="28" Background="Transparent" AutomationProperties.Name="Maximize">
            <Ellipse x:Name="MaximizeDot" Width="14" Height="14" StrokeThickness="0" />
            <Ellipse x:Name="MaximizePress" Width="14" Height="14" Fill="Black" Opacity="0" IsHitTestVisible="False" />
            <Viewbox x:Name="MaximizeGlyph" Width="14" Height="14" Opacity="0" IsHitTestVisible="False">
                <Canvas Width="12" Height="12">
                    <Path x:Name="MaximizeOut" Data="M3.4,3.4 L7,3.4 L3.4,7 Z M8.6,8.6 L5,8.6 L8.6,5 Z" Fill="{ThemeResource WindowControlGlyphBrush}" />
                    <Path x:Name="MaximizeIn" Data="M5.6,5.6 L2.6,5.6 L5.6,2.6 Z M6.4,6.4 L9.4,6.4 L6.4,9.4 Z" Fill="{ThemeResource WindowControlGlyphBrush}" />
                </Canvas>
            </Viewbox>
        </Grid>
        <Grid x:Name="CloseHit" Width="23" Height="28" Background="Transparent" AutomationProperties.Name="Close">
            <Ellipse x:Name="CloseDot" Width="14" Height="14" StrokeThickness="0" />
            <Ellipse x:Name="ClosePress" Width="14" Height="14" Fill="Black" Opacity="0" IsHitTestVisible="False" />
            <Viewbox x:Name="CloseGlyph" Width="14" Height="14" Opacity="0" IsHitTestVisible="False">
                <Canvas Width="12" Height="12">
                    <Path Data="M3.9,3.9 L8.1,8.1 M8.1,3.9 L3.9,8.1" Stroke="{ThemeResource WindowControlGlyphBrush}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>
        </Grid>
    </StackPanel>
</UserControl>
