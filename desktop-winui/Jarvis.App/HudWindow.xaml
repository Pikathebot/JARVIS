<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Jarvis_App.HudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:glass="using:Jarvis_Glass"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Jarvis HUD"
    mc:Ignorable="d">

    <!--
        The card is a liquid-glass slab rendered BEHIND this window by its GlassHost; the XAML
        here only draws the chrome and text on top of a transparent backdrop.
    -->
    <glass:GlassSlab x:Name="Card" Material="Thick" SlabCornerRadius="{StaticResource RadiusSheet}">
            <Grid Padding="16,12" Background="Transparent" PointerPressed="Card_PointerPressed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse
                    x:Name="MicButton"
                    Grid.Column="0"
                    Width="52"
                    Height="52"
                    Fill="{ThemeResource FillTertiaryBrush}"
                    Stroke="{ThemeResource LabelSecondaryBrush}"
                    StrokeThickness="2"
                    Tapped="MicButton_Tapped" />

                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StateLabel" Text="Offline" Style="{StaticResource BodyEmphasisText}" Foreground="{ThemeResource LabelSecondaryBrush}" />
                    <TextBlock x:Name="CaptionText" Text="" Style="{StaticResource SecondaryFootnoteText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Measured readouts: tabular mono; they turn status colours past their limit and say so in words. -->
                    <TextBlock x:Name="VramRing" Text="VRAM —" Style="{StaticResource DataText}" />
                    <TextBlock x:Name="GpuRing" Text="GPU —" Style="{StaticResource DataText}" />
                </StackPanel>
            </Grid>
    </glass:GlassSlab>
</Window>
