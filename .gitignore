# Virtual environment
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.dll
*.exe
*.so
*.dylib

# AI Models & Tools Binaries
# Anchored with a leading slash: unanchored, these match a directory of that name at ANY
# depth, and "models/" was quietly excluding desktop-winui/Jarvis.Core/Models/ -- the client's
# whole DTO layer -- from every commit.
/models/
*.gguf
/tools/

# Environment variables
.env
!.env.example

# SQLite Databases
*.db
*.sqlite3

# Logs & testing
*.log
.pytest_cache/
.coverage
htmlcov/
test_sandbox*/

# App Data & Webview Cache
/data/
backend/data/

# Build & packaging
/build/
/dist/
*.spec
*.zip

# Nested / duplicate snapshots
/jarvis_project/
/workspace/
backend/workspace/
*.tsbuildinfo

# OS specific
.DS_Store
Thumbs.db


# Runtime artifacts
/graphify-out/
/projects/
backend/projects/
/MagicMock/
backend/files/
/files/
